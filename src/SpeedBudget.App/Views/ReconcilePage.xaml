<Page x:Class="SpeedBudget.App.Views.ReconcilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:vm="using:SpeedBudget.App.ViewModels">
    <ScrollViewer>
        <StackPanel Margin="32,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Reconcile" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="Compare an account with its bank statement. Transactions the bank has processed are cleared; the rest are uncleared. Entering a bank date on a transaction clears it too." />
            <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning" Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />

            <TextBlock Text="Add an account first." Visibility="{x:Bind NoAccounts}" Opacity="0.8" />

            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasAccount, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Header="Account" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Accounts}" DisplayMemberPath="Name"
                              SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}" />
                    <NumberBox app:Money.Format="True" Grid.Column="1" Header="Bank statement balance (R)" PlaceholderText="0.00" SpinButtonPlacementMode="Hidden"
                               AutomationProperties.Name="Bank statement balance"
                               Value="{x:Bind ViewModel.Statement, Mode=TwoWay}" />
                </Grid>

                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Balance in your records" />
                                <TextBlock Text="{x:Bind ViewModel.BookText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Cleared balance" />
                                <TextBlock Text="{x:Bind ViewModel.ClearedText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Uncleared transactions" />
                                <TextBlock Text="{x:Bind ViewModel.UnclearedText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Difference from statement" />
                                <TextBlock Text="{x:Bind ViewModel.DifferenceText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Available for spending (statement plus uncleared)" />
                            <TextBlock Text="{x:Bind ViewModel.AvailableText, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Uncleared transactions" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.Uncleared}" SelectionMode="None" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:UnclearedRow">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind DateText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Payee}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind AmountText}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="3" Content="Clear" IsChecked="{x:Bind IsCleared, Mode=TwoWay}" MinWidth="0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
