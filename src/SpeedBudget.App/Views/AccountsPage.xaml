<Page x:Class="SpeedBudget.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:vm="using:SpeedBudget.App.ViewModels">
    <Grid Margin="32,24" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Accounts" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                       Text="Budget accounts affect the budget with every transaction. Tracked accounts only record their own transactions and balance." />
            <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Error" Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />
        </StackPanel>

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Content="Add account" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Accounts}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountRow">
                        <StackPanel Padding="0,8">
                            <TextBlock Text="{x:Bind Display, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Kind, Mode=OneWay}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="16" MaxWidth="480" HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <TextBox Header="Name" Text="{x:Bind ViewModel.Selected.Name, Mode=TwoWay, FallbackValue=''}" />
            <ComboBox Header="Type" HorizontalAlignment="Stretch"
                      SelectedIndex="{x:Bind ViewModel.Selected.TypeIndex, Mode=TwoWay, FallbackValue=0}">
                <ComboBoxItem Content="Cheque" />
                <ComboBoxItem Content="Savings" />
                <ComboBoxItem Content="Credit card" />
                <ComboBoxItem Content="Cash" />
                <ComboBoxItem Content="Investment" />
                <ComboBoxItem Content="Loan" />
            </ComboBox>
            <ToggleSwitch Header="Counts toward the budget" OnContent="Budget account" OffContent="Tracked account"
                          IsOn="{x:Bind ViewModel.Selected.IsOnBudget, Mode=TwoWay, FallbackValue=true}" />
            <NumberBox app:Money.Format="True" Header="Opening balance (R)" SpinButtonPlacementMode="Hidden" SmallChange="1"
                       Value="{x:Bind ViewModel.Selected.OpeningBalance, Mode=TwoWay, FallbackValue=0}" />
            <ToggleSwitch Header="Closed" OnContent="Closed, hidden from entry" OffContent="Open"
                          IsOn="{x:Bind ViewModel.Selected.IsClosed, Mode=TwoWay, FallbackValue=false}" />
            <Button Content="Delete account" Click="Delete_Click" />
        </StackPanel>
    </Grid>
</Page>
