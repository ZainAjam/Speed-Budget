<UserControl x:Class="SpeedBudget.App.Views.IconPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App">
    <StackPanel Spacing="8">
        <TextBlock x:Name="HeaderText" Visibility="Collapsed" />
        <Button x:Name="PickerButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ValueText" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12" />
            </Grid>
            <Button.Flyout>
                <Flyout x:Name="PickerFlyout" Placement="Bottom" Opened="Flyout_Opened">
                    <StackPanel Width="380" Spacing="8">
                        <TextBox x:Name="SearchBox" PlaceholderText="Search icons, such as car, health or school" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" />
                        <ListView x:Name="ResultList" MaxHeight="360" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Result_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="app:EmojiChoice">
                                    <Grid ColumnSpacing="12" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Emoji}" FontSize="20" HorizontalTextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Group}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.55" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="SourceNote" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
