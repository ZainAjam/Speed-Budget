<Page x:Class="SpeedBudget.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,24" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="App Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" />

            <StackPanel Spacing="8">
                <TextBlock Text="Setup" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="Run the setup wizard" Click="Setup_Click" />
                <TextBlock Text="Adds accounts, budget groups and items, and common counterparties from a template. Anything you already have is left as it is." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="Backup and export" Style="{StaticResource TitleTextBlockStyle}" FontSize="22" Margin="0,8,0,0" />

            <StackPanel Spacing="8">
                <TextBlock Text="Your data" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="DataPath" IsTextSelectionEnabled="True" TextWrapping="Wrap" Opacity="0.8" />
                <TextBlock Text="Everything is stored in one file on this PC. Copy the folder, or keep it in OneDrive, to move your budget." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Backups" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="BackupInfo" TextWrapping="Wrap" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Back up now" Click="BackUp_Click" />
                    <Button Content="Open backups folder" Click="OpenBackups_Click" />
                </StackPanel>
                <TextBlock Text="A backup is made automatically when the app opens, at most once a day. The newest 14 are kept. To restore one, close the app and copy it over budget.db in the data folder."
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Export" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Export transactions (CSV)" Click="ExportCsv_Click" />
                    <Button Content="Export everything (JSON)" Click="ExportJson_Click" />
                </StackPanel>
                <TextBlock Text="The CSV opens in Excel or Google Sheets. Month lines appear as NEW MONTH rows, as in the sheet." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="Reset" Style="{StaticResource TitleTextBlockStyle}" FontSize="22" Margin="0,8,0,0" />

            <StackPanel Spacing="8">
                <TextBlock Text="Factory reset" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="Reset the app…" Click="Reset_Click" />
                <TextBlock Text="Deletes all your accounts, budget items, transactions, counterparties and settings, so the app starts again from a clean slate and the setup wizard runs. A backup is saved first."
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Sync" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Syncing between devices isn't set up yet. Your data is already prepared for it, so nothing will need converting when it arrives."
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox x:Name="UpdateSource" Header="Where updates are published" PlaceholderText="https://github.com/ZainAjam/Speed-Budget"
                         LostFocus="UpdateSource_LostFocus" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CheckButton" Content="Check for updates" Click="CheckUpdates_Click" />
                    <Button x:Name="InstallButton" Content="Install and restart" Style="{StaticResource AccentButtonStyle}" Click="InstallUpdate_Click" Visibility="Collapsed" />
                </StackPanel>
                <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Maximum="100" />
                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Opacity="0.8" />
                <TextBlock Text="The app checks when it opens and every few hours. By default it looks at the Speed Budget releases on GitHub; a GitHub address, web address or folder can be entered above instead. An update never changes your data: it is kept separately from the program." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="AboutText" Opacity="0.8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
