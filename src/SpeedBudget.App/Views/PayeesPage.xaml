<Page x:Class="SpeedBudget.App.Views.PayeesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpeedBudget.App.ViewModels">
    <Grid Margin="32,24" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Counterparties" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                       Text="A counterparty is who a transaction is with: a person or business you pay, or who pays you. You can also add a counterparty while entering a transaction. Renaming a counterparty renames it on all of its transactions." />
            <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning" Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />
        </StackPanel>

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Search counterparties" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search counterparties" />
                <Button Grid.Column="1" Content="Add counterparty" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PayeeRow">
                        <StackPanel Padding="0,6">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind UsageText, Mode=OneWay}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="16" MaxWidth="480" HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <TextBox Header="Name" Text="{x:Bind ViewModel.Selected.Name, Mode=TwoWay, FallbackValue=''}" />
            <TextBlock Text="{x:Bind ViewModel.Selected.UsageText, Mode=OneWay, FallbackValue=''}" Opacity="0.7" />
            <Button Content="Delete counterparty" Click="Delete_Click" />
        </StackPanel>
    </Grid>
</Page>
