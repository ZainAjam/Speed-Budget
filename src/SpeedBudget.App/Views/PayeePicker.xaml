<UserControl x:Class="SpeedBudget.App.Views.PayeePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Spacing 8 matches the gap between a header and its box on the built-in controls, so rows of fields line up. -->
    <StackPanel Spacing="8">
        <TextBlock x:Name="HeaderText" Visibility="Collapsed" />
        <Button x:Name="PickerButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ValueText" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12" />
            </Grid>
            <Button.Flyout>
                <Flyout x:Name="PickerFlyout" Placement="Bottom" Opened="Flyout_Opened">
                    <StackPanel Width="340" Spacing="8">
                        <TextBox x:Name="SearchBox" PlaceholderText="Search counterparties, or type a new one" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" />
                        <ListView x:Name="ResultList" MaxHeight="320" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Result_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="Hint" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Enter picks the first match, or adds the counterparty if nothing matches. Ctrl+Enter always adds what you typed." />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
