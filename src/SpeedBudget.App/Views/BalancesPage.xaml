<Page x:Class="SpeedBudget.App.Views.BalancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:local="using:SpeedBudget.App.Views"
    xmlns:vm="using:SpeedBudget.App.ViewModels">
    <Grid Margin="32,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The account, and the totals since the first balance -->
        <Grid ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Kept by its balances: type in the balance (usually every day) and anything withdrawn, and the changes, gains and losses are worked out for you."
                           Opacity="0.7" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28" VerticalAlignment="Bottom">
                <StackPanel>
                    <TextBlock Text="Balance now" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.BalanceText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Total changes" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.ChangeText, Mode=OneWay}" Foreground="{x:Bind ViewModel.ChangeBrush, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Withdrawals" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.WithdrawalsText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Gains / losses" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.GainsText, Mode=OneWay}" Foreground="{x:Bind ViewModel.GainsBrush, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Which table to look at -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <ToggleButton x:Name="DailyButton" Content="Daily balances" IsChecked="True" Click="Daily_Click" />
            <ToggleButton x:Name="MonthButton" Content="By month" Click="Month_Click" />
            <TextBlock Text="{x:Bind ViewModel.SinceText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" Margin="8,0,0,0" />
        </StackPanel>

        <local:ZoomBox Grid.Row="2">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning" IsClosable="False"
                         Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

                <!-- The daily balances -->
                <Grid Grid.Row="1" Grid.RowSpan="2" RowSpacing="8" Visibility="{x:Bind ViewModel.ShowDaily, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Date" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Balance" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Total changes" FontWeight="SemiBold" HorizontalTextAlignment="Right" ToolTipService.ToolTip="The balance now against the first balance" />
                        <TextBlock Grid.Column="3" Text="Daily changes" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Withdrawals" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Gains / losses" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="Comment" FontWeight="SemiBold" />
                    </Grid>

                    <!-- The boxes for the next balance (Enter adds it) -->
                    <Grid Grid.Row="1" Padding="8,0" ColumnSpacing="8" KeyDown="Form_KeyDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <CalendarDatePicker Date="{x:Bind ViewModel.FormDate, Mode=TwoWay}" PlaceholderText="Date" Width="130"
                                            AutomationProperties.Name="Date of the balance" />
                        <NumberBox Grid.Column="1" app:Money.Format="True" Value="{x:Bind ViewModel.FormBalance, Mode=TwoWay}" SpinButtonPlacementMode="Hidden"
                                   PlaceholderText="Balance" AutomationProperties.Name="Balance" />
                        <NumberBox Grid.Column="4" app:Money.Format="True" Value="{x:Bind ViewModel.FormWithdrawal, Mode=TwoWay}" SpinButtonPlacementMode="Hidden"
                                   PlaceholderText="Withdrawn" AutomationProperties.Name="Amount withdrawn" />
                        <TextBox Grid.Column="6" Text="{x:Bind ViewModel.FormComment, Mode=TwoWay}" PlaceholderText="Comment (optional)" AutomationProperties.Name="Comment" />
                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6">
                            <Button Content="{x:Bind ViewModel.SaveText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                            <Button Content="Cancel" Click="CancelChange_Click" Visibility="{x:Bind ViewModel.IsChanging, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BalanceLine">
                                <Grid Padding="8,6" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DateText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind BalanceText}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TotalChangeText}" Foreground="{x:Bind TotalChangeBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DailyChangeText}" Foreground="{x:Bind DailyChangeBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind WithdrawalText}" Foreground="{x:Bind WithdrawalBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind GainText}" Foreground="{x:Bind GainBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind CommentText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2">
                                        <Button Click="Edit_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Change this balance" ToolTipService.ToolTip="Change">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#E9B72C" />
                                        </Button>
                                        <Button Click="Delete_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Delete this balance" ToolTipService.ToolTip="Delete">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" Text="Nothing yet. Type in the balance on a date above and press Add." Opacity="0.7" Margin="8,12,0,0"
                               Visibility="{x:Bind ViewModel.ShowDailyEmpty, Mode=OneWay}" />
                </Grid>

                <!-- The month by month summary -->
                <Grid Grid.Row="1" Grid.RowSpan="2" RowSpacing="8" Visibility="{x:Bind ViewModel.ShowMonths, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" MaxWidth="900" HorizontalAlignment="Left"
                               Text="Gains / losses: what the market did to the fund in the month. Withdrawals: what was taken out. Money left to reinvest: the gains after the withdrawals; when it is below zero, the withdrawals reached into earlier gains and then into the original investment." />
                    <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Month" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Gains / losses" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Withdrawals" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Money left to reinvest" FontWeight="SemiBold" HorizontalTextAlignment="Right" />
                    </Grid>
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Months}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BalanceMonthLine">
                                <Grid Padding="8,6" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Month}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GainsText}" Foreground="{x:Bind GainsBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind WithdrawalsText}" Foreground="{x:Bind WithdrawalsBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind LeftText}" Foreground="{x:Bind LeftBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </local:ZoomBox>
    </Grid>
</Page>
