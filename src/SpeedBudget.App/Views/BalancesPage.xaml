<Page x:Class="SpeedBudget.App.Views.BalancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:local="using:SpeedBudget.App.Views"
    xmlns:vm="using:SpeedBudget.App.ViewModels">
    <Grid Margin="32,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The account, and the totals since the first balance -->
        <Grid ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Bottom" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28" VerticalAlignment="Bottom">
                <StackPanel ToolTipService.ToolTip="The balance on the latest line">
                    <TextBlock Text="Balance now" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.BalanceText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel ToolTipService.ToolTip="The latest balance against the very first balance: how much the fund has changed in total, withdrawals included">
                    <TextBlock Text="Total changes" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.ChangeText, Mode=OneWay}" Foreground="{x:Bind ViewModel.ChangeBrush, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel ToolTipService.ToolTip="Everything taken out of the fund since the first balance">
                    <TextBlock Text="Withdrawals" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.WithdrawalsText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel ToolTipService.ToolTip="What the market has done to the fund since the first balance: the changes with the withdrawals put back">
                    <TextBlock Text="Gains / losses" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.GainsText, Mode=OneWay}" Foreground="{x:Bind ViewModel.GainsBrush, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Add Entry on the left; which table to look at, and the Excel import, on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Add Entry" Style="{StaticResource AccentButtonStyle}" Click="AddEntry_Click" HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.ShowDaily, Mode=OneWay}"
                    ToolTipService.ToolTip="Add the balance on a date, with anything you took out and a comment if you like" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="DailyButton" Content="Daily balances" IsChecked="True" Click="Daily_Click" />
                <ToggleButton x:Name="MonthButton" Content="By month" Click="Month_Click" />
                <!-- Fill in balances in Excel: get a blank template, then import it once it is filled in -->
                <Button Margin="20,0,0,0" AutomationProperties.Name="Import balances from Excel"
                        ToolTipService.ToolTip="Fill in balances in an Excel file, then bring them in here">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Excel import" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Get a blank Excel template…" Click="GetTemplate_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Import a filled-in template…" Click="Import_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <local:ZoomBox Grid.Row="2">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}" IsClosable="False"
                         Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

                <!-- The daily balances -->
                <Grid Grid.Row="1" Grid.RowSpan="2" RowSpacing="8" Visibility="{x:Bind ViewModel.ShowDaily, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <!-- What each heading means is in its tooltip -->
                        <TextBlock Text="Date" FontWeight="SemiBold" ToolTipService.ToolTip="The date of the balance" />
                        <TextBlock Grid.Column="1" Text="Balance" FontWeight="SemiBold" HorizontalTextAlignment="Right"
                                   ToolTipService.ToolTip="The balance of the fund on that date, as you read it from the website or statement" />
                        <TextBlock Grid.Column="2" Text="Total changes" FontWeight="SemiBold" HorizontalTextAlignment="Right"
                                   ToolTipService.ToolTip="The balance on that date against the very first balance: how much the fund has changed in total since you started, withdrawals included" />
                        <TextBlock Grid.Column="3" Text="Daily changes" FontWeight="SemiBold" HorizontalTextAlignment="Right"
                                   ToolTipService.ToolTip="The balance on that date against the balance on the line before it" />
                        <TextBlock Grid.Column="4" Text="Withdrawals" FontWeight="SemiBold" HorizontalTextAlignment="Right"
                                   ToolTipService.ToolTip="Money you took out of the fund on that date. It is not a loss, so it is put back when the gains and losses are worked out" />
                        <TextBlock Grid.Column="5" Text="Gains / losses" FontWeight="SemiBold" HorizontalTextAlignment="Right"
                                   ToolTipService.ToolTip="What the market did to the fund that day: the daily change with any withdrawal put back" />
                        <TextBlock Grid.Column="6" Text="Comment" FontWeight="SemiBold" ToolTipService.ToolTip="Anything you want to remember about that line" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BalanceLine">
                                <!-- Pressing the pencil turns this line's own cells into boxes (Enter saves, Esc leaves it as it was) -->
                                <Grid Padding="8,6" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                      Tag="{x:Bind}" KeyDown="Line_KeyDown">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DateText}" VerticalAlignment="Center" Visibility="{x:Bind IsViewing, Mode=OneWay}" />
                                    <CalendarDatePicker Date="{x:Bind EditDate, Mode=TwoWay}" Width="130" VerticalAlignment="Center" Visibility="{x:Bind IsEditing, Mode=OneWay}"
                                                        AutomationProperties.Name="Date of the balance" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind BalanceText}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind IsViewing, Mode=OneWay}" />
                                    <NumberBox Grid.Column="1" app:Money.Format="True" Value="{x:Bind EditBalance, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"
                                               PlaceholderText="Balance" Loaded="BalanceBox_Loaded"
                                               Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Balance" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TotalChangeText}" Foreground="{x:Bind TotalChangeBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind HasFigures}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DailyChangeText}" Foreground="{x:Bind DailyChangeBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind HasFigures}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind WithdrawalText}" Foreground="{x:Bind WithdrawalBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind IsViewing, Mode=OneWay}" />
                                    <NumberBox Grid.Column="4" app:Money.Format="True" Value="{x:Bind EditWithdrawal, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"
                                               PlaceholderText="Withdrawn" Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Amount withdrawn" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind GainText}" Foreground="{x:Bind GainBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind HasFigures}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind CommentText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" Visibility="{x:Bind IsViewing, Mode=OneWay}" />
                                    <TextBox Grid.Column="6" Text="{x:Bind EditComment, Mode=TwoWay}" VerticalAlignment="Center" PlaceholderText="Comment (optional)"
                                             Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Comment" />
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" Visibility="{x:Bind IsViewing, Mode=OneWay}">
                                        <Button Click="Edit_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Change this balance" ToolTipService.ToolTip="Change">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#E9B72C" />
                                        </Button>
                                        <Button Click="Delete_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Delete this balance" ToolTipService.ToolTip="Delete">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" Visibility="{x:Bind IsEditing, Mode=OneWay}">
                                        <Button Click="SaveLine_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Save this balance" ToolTipService.ToolTip="Save">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#2FB36D" />
                                        </Button>
                                        <Button Click="CancelLine_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Leave this balance as it was" ToolTipService.ToolTip="Cancel">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="Nothing yet. Press Add Entry to add the balance on a date." Opacity="0.7" Margin="8,12,0,0"
                               Visibility="{x:Bind ViewModel.ShowDailyEmpty, Mode=OneWay}" />
                </Grid>

                <!-- The month by month summary -->
                <Grid Grid.Row="1" Grid.RowSpan="2" RowSpacing="8" Visibility="{x:Bind ViewModel.ShowMonths, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Month" FontWeight="SemiBold" ToolTipService.ToolTip="The month, written year-month" />
                        <TextBlock Grid.Column="1" Text="Gains / losses" FontWeight="SemiBold" HorizontalTextAlignment="Right"
                                   ToolTipService.ToolTip="What the market did to the fund in the month: its daily gains and losses added up" />
                        <TextBlock Grid.Column="2" Text="Withdrawals" FontWeight="SemiBold" HorizontalTextAlignment="Right"
                                   ToolTipService.ToolTip="What was taken out of the fund in the month" />
                        <TextBlock Grid.Column="3" Text="Money left to reinvest" FontWeight="SemiBold" HorizontalTextAlignment="Right"
                                   ToolTipService.ToolTip="The gains after the withdrawals. When it is below zero, the withdrawals were bigger than the month's gains and reached into earlier gains and then into the original investment" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Months}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BalanceMonthLine">
                                <Grid Padding="8,6" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Month}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GainsText}" Foreground="{x:Bind GainsBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind WithdrawalsText}" Foreground="{x:Bind WithdrawalsBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind LeftText}" Foreground="{x:Bind LeftBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </local:ZoomBox>
    </Grid>
</Page>
