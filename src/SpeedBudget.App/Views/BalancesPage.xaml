<Page x:Class="SpeedBudget.App.Views.BalancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:local="using:SpeedBudget.App.Views"
    xmlns:vm="using:SpeedBudget.App.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <!-- The tables look like the transactions table: a shaded heading and thin lines between cells -->
        <SolidColorBrush x:Key="HeadingBrush" Color="{ThemeResource SystemAccentColorDark2}" />
        <Style x:Key="HeadingBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeadingBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,8" />
        </Style>
        <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>
    <Grid Margin="32,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The account, and its totals since the first balance -->
        <!-- When the window is narrower than the title and totals need, they are made smaller together, in place (the box is as wide as the room, or as the heading needs if that is more) -->
        <Grid x:Name="HeaderHost" SizeChanged="Header_SizeChanged">
        <Viewbox x:Name="HeaderBox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid x:Name="HeaderGrid" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" SizeChanged="Header_SizeChanged" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Bottom"
                       TextWrapping="NoWrap" />
            <StackPanel x:Name="TotalsPanel" Grid.Column="1" SizeChanged="Header_SizeChanged" Orientation="Horizontal" Spacing="24" VerticalAlignment="Bottom">
                <StackPanel ToolTipService.ToolTip="The balance on the very first line: what the fund was worth when you started">
                    <TextBlock Text="Original balance" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.OriginalText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel ToolTipService.ToolTip="The balance on the latest line">
                    <TextBlock Text="Balance now" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.BalanceText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <Rectangle Width="1" Height="40" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                <StackPanel ToolTipService.ToolTip="What the market has done to the fund since the first balance: the daily gains and losses added up, with the withdrawals put back">
                    <TextBlock Text="Total Gains / Losses" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.GainsText, Mode=OneWay}" Foreground="{x:Bind ViewModel.GainsBrush, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel ToolTipService.ToolTip="Everything taken out of the fund since the first balance">
                    <TextBlock Text="Total Withdrawals" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.WithdrawalsText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel ToolTipService.ToolTip="The gains and losses after the withdrawals are taken off: the latest balance against the very first balance">
                    <TextBlock Text="Total Net Gains / Losses" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.ChangeText, Mode=OneWay}" Foreground="{x:Bind ViewModel.ChangeBrush, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
        </Viewbox>
        </Grid>

        <!-- Add Entry on the left; which table to look at, and the Excel import, on the right -->
        <Grid x:Name="ButtonsHost" Grid.Row="1" SizeChanged="Buttons_SizeChanged">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid x:Name="ButtonsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LeftButtons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.ShowDaily, Mode=OneWay}">
                <Button Content="Add Entry" Style="{StaticResource AccentButtonStyle}" Click="AddEntry_Click"
                        ToolTipService.ToolTip="Add the balance on a date, with anything you took out and a comment if you like" />
            </StackPanel>
            <StackPanel x:Name="RightButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox Width="170" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowDaily, Mode=OneWay}" AutomationProperties.Name="Sort order">
                    <ComboBoxItem Content="Show newest first" />
                    <ComboBoxItem Content="Show oldest first" />
                </ComboBox>
                <ToggleButton x:Name="DailyButton" IsChecked="True" Click="Daily_Click" AutomationProperties.Name="Transactions" ToolTipService.ToolTip="Transactions: the balance on each date">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="MonthButton" Click="Month_Click" AutomationProperties.Name="Report" ToolTipService.ToolTip="Report: the gains, withdrawals and money left for each month">
                    <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                </ToggleButton>
                <!-- The overflow menu: import from and export to Excel -->
                <Button Margin="12,0,0,0" AutomationProperties.Name="More" ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Import from Excel…" Click="Import_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Export to Excel…" Click="Export_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        </Viewbox>
        </Grid>

        <Grid Grid.Row="2">
        <local:ZoomBox x:Name="TableZoom">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}" IsClosable="False"
                         Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

                <!-- The daily balances: lines between the cells, and the edge of a heading can be dragged to change the column's width -->
                <Grid x:Name="DailyTable" Grid.Row="1" Grid.RowSpan="2" RowSpacing="0" Visibility="{x:Bind ViewModel.ShowDaily, Mode=OneWay}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.AllLine, Mode=OneWay}" CornerRadius="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="DailyHeading">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Columns.LeadWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.Date, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.Balance, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.TotalChange, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.DailyChange, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.Withdrawal, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.Gain, Mode=OneWay}" />
                            <ColumnDefinition Width="*" MinWidth="{x:Bind Columns.CommentMin, Mode=OneWay}" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" Padding="0" Visibility="{x:Bind Columns.Selecting, Mode=OneWay}">
                            <CheckBox x:Name="SelectAllBox" MinWidth="0" Padding="0" HorizontalAlignment="Center" Click="SelectAll_Click" AutomationProperties.Name="Select all lines"
                                      ToolTipService.ToolTip="Tick all the lines, or none" />
                        </Border>
                        <!-- What each heading means is in its tooltip -->
                        <Border Grid.Column="1" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Date" ToolTipService.ToolTip="The date of the balance" /></Border>
                        <Border Grid.Column="2" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Balance" HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="The balance of the fund on that date, as you read it from the website or statement" /></Border>
                        <Border Grid.Column="3" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Total changes" HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="The balance on that date against the very first balance: how much the fund has changed in total since you started, withdrawals included" /></Border>
                        <Border Grid.Column="4" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Daily changes" HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="The balance on that date against the balance on the line before it" /></Border>
                        <Border Grid.Column="5" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Withdrawals" HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="Money you took out of the fund on that date. It is not a loss, so it is put back when the gains and losses are worked out" /></Border>
                        <Border Grid.Column="6" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Gains / losses" HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="What the market did to the fund that day: the daily change with any withdrawal put back" /></Border>
                        <Border Grid.Column="7" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Comment" ToolTipService.ToolTip="Anything you want to remember about that line" /></Border>
                        <Border Grid.Column="8" Style="{StaticResource HeadingBorder}" BorderThickness="0" />
                        <!-- Drag the right edge of a heading to resize that column, as in the transactions table -->
                        <local:ResizeGrip Grid.Column="1" Tag="0" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="2" Tag="1" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="3" Tag="2" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="4" Tag="3" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="5" Tag="4" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="6" Tag="5" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="Single" x:Name="LinesList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BalanceLine">
                                <!-- Pressing the pencil turns this line's own cells into boxes (Enter saves, Esc leaves it as it was) -->
                                <Grid Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.BottomLine, Mode=OneWay}"
                                      Tag="{x:Bind}" KeyDown="Line_KeyDown" ContextRequested="Line_ContextRequested" Tapped="Line_Tapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind Columns.LeadWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Tick it to select this line for deleting together with the other ticked ones -->
                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" Visibility="{x:Bind Columns.Selecting, Mode=OneWay}">
                                        <CheckBox IsChecked="{x:Bind IsTicked, Mode=TwoWay}" MinWidth="0" MinHeight="0" Height="24" Padding="0" Width="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{x:Bind ShowTick}" AutomationProperties.Name="Select this line" />
                                    </Border>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind Columns.Date, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Columns.Balance, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Columns.TotalChange, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Columns.DailyChange, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Columns.Withdrawal, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Columns.Gain, Mode=OneWay}" />
                                        <ColumnDefinition Width="*" MinWidth="{x:Bind Columns.CommentMin, Mode=OneWay}" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Lines between the cells -->
                                    <Border Grid.Column="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />
                                    <Border Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />
                                    <Border Grid.Column="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />
                                    <Border Grid.Column="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />
                                    <Border Grid.Column="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />
                                    <Border Grid.Column="5" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />
                                    <Border Grid.Column="6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />

                                    <TextBlock Text="{x:Bind DateText}" VerticalAlignment="Center" Margin="8,6" Visibility="{x:Bind IsViewing, Mode=OneWay}" />
                                    <CalendarDatePicker Date="{x:Bind EditDate, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,3" Visibility="{x:Bind IsEditing, Mode=OneWay}"
                                                        AutomationProperties.Name="Date of the balance" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind BalanceText}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="8,6" Visibility="{x:Bind IsViewing, Mode=OneWay}" />
                                    <NumberBox Grid.Column="1" app:Money.Format="True" Value="{x:Bind EditBalance, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center" Margin="4,3"
                                               PlaceholderText="Balance" Loaded="BalanceBox_Loaded"
                                               Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Balance" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TotalChangeText}" Foreground="{x:Bind TotalChangeBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="8,6" Visibility="{x:Bind HasFigures}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DailyChangeText}" Foreground="{x:Bind DailyChangeBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="8,6" Visibility="{x:Bind HasFigures}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind WithdrawalText}" Foreground="{x:Bind WithdrawalBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="8,6" Visibility="{x:Bind IsViewing, Mode=OneWay}" />
                                    <NumberBox Grid.Column="4" app:Money.Format="True" Value="{x:Bind EditWithdrawal, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center" Margin="4,3"
                                               PlaceholderText="Withdrawn" Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Amount withdrawn" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind GainText}" Foreground="{x:Bind GainBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="8,6" Visibility="{x:Bind HasFigures}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind CommentText}" VerticalAlignment="Center" Margin="8,6" TextTrimming="CharacterEllipsis" Opacity="0.85" Visibility="{x:Bind IsViewing, Mode=OneWay}" />
                                    <TextBox Grid.Column="6" Text="{x:Bind EditComment, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,3" PlaceholderText="Comment (optional)"
                                             Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Comment" />
                                    <Grid Grid.Column="7" Opacity="{x:Bind Columns.ActionsOpacity, Mode=OneWay}" IsHitTestVisible="{x:Bind Columns.NotSelecting, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,2" Visibility="{x:Bind IsViewing, Mode=OneWay}">
                                        <Button Click="Edit_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Change this balance" ToolTipService.ToolTip="Change">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#E9B72C" />
                                        </Button>
                                        <Button Click="Delete_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Delete this balance" ToolTipService.ToolTip="Delete">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" Margin="6,2" Visibility="{x:Bind IsEditing, Mode=OneWay}">
                                        <Button Click="SaveLine_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Save this balance" ToolTipService.ToolTip="Save">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#2FB36D" />
                                        </Button>
                                        <Button Click="CancelLine_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Leave this balance as it was" ToolTipService.ToolTip="Cancel">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="Nothing yet. Press Add Entry to add the balance on a date." Opacity="0.7" Margin="8,12,0,0"
                               Visibility="{x:Bind ViewModel.ShowDailyEmpty, Mode=OneWay}" />
                </Grid>

                <!-- The month by month summary -->
                <Grid Grid.Row="1" Grid.RowSpan="2" RowSpacing="0" Visibility="{x:Bind ViewModel.ShowMonths, Mode=OneWay}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.AllLine, Mode=OneWay}" CornerRadius="6" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Columns.Month, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.MonthGains, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.MonthWithdrawals, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Columns.MonthLeft, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Month" ToolTipService.ToolTip="The month, written year-month" /></Border>
                        <Border Grid.Column="1" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Gains / losses" HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="What the market did to the fund in the month: its daily gains and losses added up" /></Border>
                        <Border Grid.Column="2" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}"><TextBlock Style="{StaticResource HeadingText}" Text="Withdrawals" HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="What was taken out of the fund in the month" /></Border>
                        <Border Grid.Column="3" Style="{StaticResource HeadingBorder}" BorderThickness="0"><TextBlock Style="{StaticResource HeadingText}" Text="Money left to reinvest" HorizontalAlignment="Right"
                                   ToolTipService.ToolTip="The gains after the withdrawals. When it is below zero, the withdrawals were bigger than the month's gains and reached into earlier gains and then into the original investment" /></Border>
                        <local:ResizeGrip Grid.Column="0" Tag="7" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="1" Tag="8" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="2" Tag="9" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="3" Tag="10" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Months}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BalanceMonthLine">
                                <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.BottomLine, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind Columns.Month, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Columns.MonthGains, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Columns.MonthWithdrawals, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Columns.MonthLeft, Mode=OneWay}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />
                                    <Border Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />
                                    <Border Grid.Column="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Columns.RightLine, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Month}" VerticalAlignment="Center" Margin="8,6" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GainsText}" Foreground="{x:Bind GainsBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="8,6" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind WithdrawalsText}" Foreground="{x:Bind WithdrawalsBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="8,6" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind LeftText}" Foreground="{x:Bind LeftBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="8,6" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </local:ZoomBox>
        <local:JumpToLatestButton x:Name="JumpButton" />
        </Grid>
    </Grid>
</Page>
