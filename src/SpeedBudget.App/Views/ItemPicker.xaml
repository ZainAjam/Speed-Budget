<UserControl x:Class="SpeedBudget.App.Views.ItemPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <TextBlock x:Name="HeaderText" Visibility="Collapsed" />
        <Button x:Name="PickerButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ValueText" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12" />
            </Grid>
            <Button.Flyout>
                <Flyout Placement="Bottom" Opened="Flyout_Opened">
                    <StackPanel Width="340" Spacing="8">
                        <TextBox x:Name="SearchBox" PlaceholderText="Search items" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" />
                        <ListView x:Name="ResultList" MaxHeight="320" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="Result_ItemClick" DisplayMemberPath="Name" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
