<ContentDialog x:Class="SpeedBudget.App.Views.NewMonthDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Let's start a new month" PrimaryButtonText="Start new month" CloseButtonText="Cancel" DefaultButton="Primary">
    <StackPanel Spacing="12" MinWidth="420">
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="A line is drawn in your transactions. Everything after it counts towards the new month. You can drag the line later. The month's budget is the one you planned ahead on the Budget screen." />
        <CalendarDatePicker x:Name="DateBox" Header="The new month starts on" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="MonthBox" Header="The month it belongs to" Width="200" SelectionChanged="MonthBox_SelectionChanged" />
            <NumberBox x:Name="YearBox" Header="Year" Width="140" Minimum="1950" Maximum="2100" SmallChange="1" LargeChange="1"
                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="YearBox_ValueChanged" />
        </StackPanel>
        <TextBlock x:Name="Preview" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                   Text="The month's name is made from the month and year you choose, so the dates always match the budget." />
    </StackPanel>
</ContentDialog>
