<Page x:Class="SpeedBudget.App.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:vm="using:SpeedBudget.App.ViewModels"
    xmlns:local="using:SpeedBudget.App.Views">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="NewMonth_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTransaction_Invoked" />
        <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="MoveLineUp_Invoked" />
        <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="MoveLineDown_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <DataTemplate x:Key="TransactionTemplate" x:DataType="vm:TransactionRow">
            <Grid ColumnSpacing="8" Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind DateText, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind PayeeText, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{x:Bind ItemName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                <TextBlock Grid.Column="3" Text="{x:Bind AccountName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                <TextBlock Grid.Column="4" Text="{x:Bind OutflowText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{x:Bind InflowText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <CheckBox Grid.Column="6" IsChecked="{x:Bind IsCleared, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MarkerTemplate" x:DataType="vm:MarkerRow">
            <StackPanel Padding="0,12,0,8" Spacing="4">
                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⠿" Opacity="0.6" VerticalAlignment="Center"
                               Visibility="{x:Bind CanDrag}" ToolTipService.ToolTip="Drag this line to change where the month starts" />
                    <TextBlock Text="{x:Bind Heading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="{x:Bind Subtotals, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </StackPanel>
        </DataTemplate>

        <local:EntryTemplateSelector x:Key="EntrySelector"
                                     TransactionTemplate="{StaticResource TransactionTemplate}"
                                     MarkerTemplate="{StaticResource MarkerTemplate}" />
    </Page.Resources>

    <Grid Margin="32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Transactions" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Width="200" ItemsSource="{x:Bind ViewModel.FilterAccounts}" DisplayMemberPath="Name"
                      SelectedItem="{x:Bind ViewModel.FilterAccount, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" Width="150" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Newest first" />
                <ComboBoxItem Content="Oldest first" />
            </ComboBox>
            <Button Grid.Column="3" Content="Add transfer" Click="Transfer_Click" />
            <Button Grid.Column="4" Content="Let's start a new month" Click="NewMonth_Click" Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Ctrl+M" />
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />

        <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CalendarDatePicker Header="Date" Date="{x:Bind ViewModel.NewDate, Mode=TwoWay}" />
                <AutoSuggestBox x:Name="PayeeBox" Grid.Column="1" Header="Payee" Text="{x:Bind ViewModel.NewPayee, Mode=TwoWay}"
                                TextChanged="Payee_TextChanged" SuggestionChosen="Payee_SuggestionChosen"
                                QuerySubmitted="Payee_QuerySubmitted" />
                <ComboBox Grid.Column="2" Header="Budget item" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ItemOptions}"
                          DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.NewItem, Mode=TwoWay}" />
                <ComboBox Grid.Column="3" Header="Account" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.EntryAccounts}"
                          DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.NewAccount, Mode=TwoWay}" />
                <NumberBox app:Money.Format="True" Grid.Column="4" Header="Outflow" PlaceholderText="0.00" SpinButtonPlacementMode="Hidden"
                           Value="{x:Bind ViewModel.NewOutflow, Mode=TwoWay}" KeyUp="Entry_KeyUp" />
                <NumberBox app:Money.Format="True" Grid.Column="5" Header="Inflow" PlaceholderText="0.00" SpinButtonPlacementMode="Hidden"
                           Value="{x:Bind ViewModel.NewInflow, Mode=TwoWay}" KeyUp="Entry_KeyUp" />
                <Button Grid.Column="6" Grid.Row="0" Content="Add" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                        Click="Add_Click" />
                <TextBox Grid.Row="1" Grid.ColumnSpan="6" Header="Memo" PlaceholderText="Optional"
                         Text="{x:Bind ViewModel.NewMemo, Mode=TwoWay}" KeyUp="Entry_KeyUp" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,0" ColumnSpacing="8" Opacity="0.7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Date" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Payee" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Budget item" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="Account" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="Outflow" HorizontalTextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="5" Text="Inflow" HorizontalTextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Column="6" Text="Clear" HorizontalTextAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <ListView Grid.Row="1" x:Name="EntryList" ItemsSource="{x:Bind ViewModel.Rows}"
                          ItemTemplateSelector="{StaticResource EntrySelector}"
                          SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                          CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                          DragItemsStarting="List_DragItemsStarting" DragItemsCompleted="List_DragItemsCompleted" />
            </Grid>

            <StackPanel Grid.Column="1" Spacing="12" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <TextBlock Text="Edit transaction" Style="{StaticResource SubtitleTextBlockStyle}" />
                <CalendarDatePicker Header="Date" Date="{x:Bind ViewModel.Selected.DateOffset, Mode=TwoWay}" />
                <TextBox Header="Payee" Text="{x:Bind ViewModel.Selected.Payee, Mode=TwoWay, FallbackValue=''}" />
                <ComboBox Header="Budget item" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ItemOptions}" DisplayMemberPath="Name"
                          SelectedItem="{x:Bind ViewModel.Selected.Item, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.Selected.CanEditAmount, Mode=OneWay, FallbackValue=true}" />
                <NumberBox app:Money.Format="True" Header="Outflow (R)" SpinButtonPlacementMode="Hidden" Value="{x:Bind ViewModel.Selected.Outflow, Mode=TwoWay}"
                           IsEnabled="{x:Bind ViewModel.Selected.CanEditAmount, Mode=OneWay, FallbackValue=true}" />
                <NumberBox app:Money.Format="True" Header="Inflow (R)" SpinButtonPlacementMode="Hidden" Value="{x:Bind ViewModel.Selected.Inflow, Mode=TwoWay}"
                           IsEnabled="{x:Bind ViewModel.Selected.CanEditAmount, Mode=OneWay, FallbackValue=true}" />
                <TextBox Header="Memo" AcceptsReturn="True" TextWrapping="Wrap" Text="{x:Bind ViewModel.Selected.Memo, Mode=TwoWay, FallbackValue=''}" />
                <CalendarDatePicker Header="Bank date (clears the transaction)" Date="{x:Bind ViewModel.Selected.BankDateOffset, Mode=TwoWay}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                           Text="Transfers can't change amount or item. Delete the transfer and add it again instead."
                           Visibility="{x:Bind ViewModel.Selected.IsTransfer, Mode=OneWay, FallbackValue=Collapsed}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                           Text="This transaction is split. Use Split to change its lines or amounts."
                           Visibility="{x:Bind ViewModel.Selected.IsSplit, Mode=OneWay, FallbackValue=Collapsed}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Split…" Click="Split_Click" IsEnabled="{x:Bind ViewModel.Selected.CanSplit, Mode=OneWay, FallbackValue=true}" />
                    <Button Content="Delete" Click="Delete_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12" Visibility="{x:Bind ViewModel.HasMarkerSelected, Mode=OneWay}">
                <TextBlock Text="Month line" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox Header="Month name" Text="{x:Bind ViewModel.SelectedMarker.Label, Mode=TwoWay, FallbackValue=''}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Opacity="0.7"
                           Text="{x:Bind ViewModel.SelectedMarker.DateText, Mode=OneWay, FallbackValue=''}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Everything after this line belongs to this month. Drag the line, or use the buttons, to change where the month starts." />
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CanChangeSelectedMarker, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Move up" Click="MoveLineUp_Click" ToolTipService.ToolTip="Alt+Up" />
                        <Button Content="Move down" Click="MoveLineDown_Click" ToolTipService.ToolTip="Alt+Down" />
                    </StackPanel>
                    <Button Content="Delete this line" Click="DeleteLine_Click" />
                </StackPanel>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Opacity="0.7"
                           Text="The first month has no line to move. Its name can be changed here."
                           Visibility="{x:Bind ViewModel.SelectedMarker.IsFirst, Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
