<Page x:Class="SpeedBudget.App.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:vm="using:SpeedBudget.App.ViewModels"
    xmlns:local="using:SpeedBudget.App.Views">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="NewMonth_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTransaction_Invoked" />
        <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="MoveLineUp_Invoked" />
        <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="MoveLineDown_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CloseDetail_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- The recorded transactions are a table: thin lines between cells and rows, and a shaded heading. -->
        <Style x:Key="CellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,7" />
        </Style>
        <SolidColorBrush x:Key="HeadingBrush" Color="{ThemeResource SystemAccentColorDark2}" />
        <Style x:Key="HeadingBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeadingBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,8" />
        </Style>
        <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="TransactionTemplate" x:DataType="vm:TransactionRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Layout.DateColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.BankDateColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="{x:Bind Layout.ItemColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.AccountColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.OutflowColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.InflowColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.ClearedColumn, Mode=OneWay}" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CellBorder}">
                    <TextBlock Text="{x:Bind DateText, Mode=OneWay}" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CellBorder}">
                    <TextBlock Text="{x:Bind BankDateText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.85" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CellBorder}" Background="Transparent" ContextRequested="Counterparty_ContextRequested">
                    <TextBlock Text="{x:Bind PayeeText, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CellBorder}" Visibility="{x:Bind ShowItemColumn}">
                    <TextBlock Text="{x:Bind ItemName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CellBorder}" Visibility="{x:Bind ShowAccountColumn}">
                    <TextBlock Text="{x:Bind AccountName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                </Border>
                <Border Grid.Column="5" Style="{StaticResource CellBorder}">
                    <TextBlock Text="{x:Bind OutflowText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CellBorder}">
                    <TextBlock Text="{x:Bind InflowText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                </Border>
                <!-- A reconciled transaction shows a padlock instead of the Cleared tick; pressing it offers to unreconcile. -->
                <Border Grid.Column="7" Style="{StaticResource CellBorder}" BorderThickness="0,0,0,1" Padding="0,2">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <CheckBox IsChecked="{x:Bind IsCleared, Mode=TwoWay}" Visibility="{x:Bind IsEditable, Mode=OneWay}" MinWidth="0"
                                  AutomationProperties.Name="Cleared" />
                        <Button Click="Padlock_Click" Tag="{x:Bind}" Visibility="{x:Bind IsReconciled, Mode=OneWay}" Padding="6" Background="Transparent"
                                BorderThickness="0" AutomationProperties.Name="Reconciled. Press to unreconcile"
                                ToolTipService.ToolTip="Reconciled. Press to unreconcile">
                            <FontIcon Glyph="&#xE72E;" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MarkerTemplate" x:DataType="vm:MarkerRow">
            <StackPanel Padding="8,12,8,8" Spacing="4">
                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind LineAbove}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⠿" Opacity="0.6" VerticalAlignment="Center"
                               Visibility="{x:Bind CanDrag}" ToolTipService.ToolTip="Drag this line to change where the month starts" />
                    <TextBlock Text="{x:Bind Heading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind LineBelow}" />
            </StackPanel>
        </DataTemplate>

        <local:EntryTemplateSelector x:Key="EntrySelector"
                                     TransactionTemplate="{StaticResource TransactionTemplate}"
                                     MarkerTemplate="{StaticResource MarkerTemplate}" />
    </Page.Resources>

    <Grid Margin="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />

        <!-- 1. Balances -->
        <Border Grid.Row="2" Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="32" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="BALANCES" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                <StackPanel Grid.Row="1">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Available bank balance" />
                    <TextBlock Text="{x:Bind ViewModel.AvailableText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Cleared bank balance" />
                    <TextBlock Text="{x:Bind ViewModel.ClearedText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Uncleared transactions" />
                    <TextBlock Text="{x:Bind ViewModel.UnclearedText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <Button Grid.Row="1" Grid.Column="4" Content="Reconcile" Click="Reconcile_Click" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.CanReconcile}" />
            </Grid>
        </Border>

        <!-- 2. What can be done: new transaction and transfer open dialogs; a new month starts a line in the list -->
        <Border Grid.Row="3" Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Style="{StaticResource AccentButtonStyle}" Click="NewTransaction_Click" ToolTipService.ToolTip="Ctrl+N">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New Transaction" />
                    </StackPanel>
                </Button>
                <Button Content="New Transfer" Click="Transfer_Click" />
                <Button Content="Start a new month" Click="NewMonth_Click" ToolTipService.ToolTip="Ctrl+M" />
            </StackPanel>
        </Border>

        <!-- 3. The recorded transactions -->
        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Recorded transactions" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <ComboBox Width="150" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" AutomationProperties.Name="Sort order">
                    <ComboBoxItem Content="Newest first" />
                    <ComboBoxItem Content="Oldest first" />
                </ComboBox>
                <CheckBox Content="Hide cleared" IsChecked="{x:Bind ViewModel.HideCleared, Mode=TwoWay}" />
                <CheckBox Content="Hide reconciled" IsChecked="{x:Bind ViewModel.HideReconciled, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- The table and the side panel. If the window is too narrow for them, this area scrolls sideways instead of squeezing the Counterparty column away. -->
        <ScrollViewer Grid.Row="5" x:Name="TableScroll" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" SizeChanged="TableScroll_SizeChanged">
        <Grid x:Name="TableRegion">
            <Border CornerRadius="6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Layout.DateColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.BankDateColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="{x:Bind Layout.ItemColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.AccountColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.OutflowColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.InflowColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.ClearedColumn, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HeadingBorder}"><TextBlock Text="Date" Style="{StaticResource HeadingText}" /></Border>
                        <Border Grid.Column="1" Style="{StaticResource HeadingBorder}"><TextBlock Text="Bank date" Style="{StaticResource HeadingText}" /></Border>
                        <Border Grid.Column="2" Style="{StaticResource HeadingBorder}"><TextBlock Text="Counterparty" Style="{StaticResource HeadingText}" /></Border>
                        <Border Grid.Column="3" Style="{StaticResource HeadingBorder}" Visibility="{x:Bind ViewModel.ShowItemColumn, Mode=OneWay}">
                            <TextBlock Text="Budget item" Style="{StaticResource HeadingText}" />
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource HeadingBorder}" Visibility="{x:Bind ViewModel.ShowAccountColumn, Mode=OneWay}">
                            <TextBlock Text="Account" Style="{StaticResource HeadingText}" />
                        </Border>
                        <Border Grid.Column="5" Style="{StaticResource HeadingBorder}"><TextBlock Text="Outflow" HorizontalTextAlignment="Right" Style="{StaticResource HeadingText}" /></Border>
                        <Border Grid.Column="6" Style="{StaticResource HeadingBorder}"><TextBlock Text="Inflow" HorizontalTextAlignment="Right" Style="{StaticResource HeadingText}" /></Border>
                        <Border Grid.Column="7" Style="{StaticResource HeadingBorder}" BorderThickness="0"><TextBlock Text="Cleared" HorizontalTextAlignment="Center" Style="{StaticResource HeadingText}" /></Border>
                        <!-- Drag the right edge of a heading to resize that column. The Counterparty edge trades room with the next column. -->
                        <local:ResizeGrip Grid.Column="0" Tag="Date" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="1" Tag="BankDate" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="2" Tag="Counterparty" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="3" Tag="Item" Visibility="{x:Bind ViewModel.ShowItemColumn, Mode=OneWay}" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="4" Tag="Account" Visibility="{x:Bind ViewModel.ShowAccountColumn, Mode=OneWay}" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="5" Tag="Outflow" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="6" Tag="Inflow" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                    </Grid>
                    <ListView Grid.Row="1" x:Name="EntryList" ItemsSource="{x:Bind ViewModel.Rows}"
                              ItemTemplateSelector="{StaticResource EntrySelector}"
                              SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                              CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsStarting="List_DragItemsStarting" DragItemsCompleted="List_DragItemsCompleted">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

        </Grid>
        </ScrollViewer>

            <!-- The edit panel floats over the table from the right edge. It slides in while a transaction or month line is selected. -->
            <Grid x:Name="DetailHost" Grid.Row="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,-32,-24"
                  Width="{x:Bind Layout.DetailWidth, Mode=OneWay}" Padding="20,16,20,16" IsHitTestVisible="False"
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ScrollViewer>
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <TextBlock Text="Edit transaction" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="This transaction is reconciled, so it is locked. Unreconcile it to make changes."
                               Visibility="{x:Bind ViewModel.Selected.IsReconciled, Mode=OneWay, FallbackValue=Collapsed}" />
                    <Button Content="Unreconcile" Click="Unreconcile_Click"
                            Visibility="{x:Bind ViewModel.Selected.IsReconciled, Mode=OneWay, FallbackValue=Collapsed}" />
                    <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Selected.IsEditable, Mode=OneWay, FallbackValue=true}">
                        <StackPanel Spacing="12">
                            <CalendarDatePicker Header="Date" Date="{x:Bind ViewModel.Selected.DateOffset, Mode=TwoWay}" />
                            <local:PayeePicker Header="Counterparty" ToolTipService.ToolTip="The counterparty is who the transaction is with: the person or business you paid, or who paid you." ItemsSource="{x:Bind ViewModel.Payees}" SelectedPayee="{x:Bind ViewModel.Selected.Payee, Mode=TwoWay}"
                                               CreateRequested="Payee_CreateRequested" />
                            <local:ItemPicker Header="Budget item" ItemsSource="{x:Bind ViewModel.ItemOptions}"
                                              SelectedItem="{x:Bind ViewModel.Selected.Item, Mode=TwoWay}" CreateRequested="Item_CreateRequested"
                                              Visibility="{x:Bind ViewModel.Selected.AccountOnBudget, Mode=OneWay, FallbackValue=Visible}"
                                              IsEnabled="{x:Bind ViewModel.Selected.CanEditAmount, Mode=OneWay, FallbackValue=true}" />
                            <NumberBox app:Money.Format="True" Header="Outflow (R)" SpinButtonPlacementMode="Hidden" Value="{x:Bind ViewModel.Selected.Outflow, Mode=TwoWay}"
                                       IsEnabled="{x:Bind ViewModel.Selected.CanEditAmount, Mode=OneWay, FallbackValue=true}" />
                            <NumberBox app:Money.Format="True" Header="Inflow (R)" SpinButtonPlacementMode="Hidden" Value="{x:Bind ViewModel.Selected.Inflow, Mode=TwoWay}"
                                       IsEnabled="{x:Bind ViewModel.Selected.CanEditAmount, Mode=OneWay, FallbackValue=true}" />
                            <TextBox Header="Memo" AcceptsReturn="True" TextWrapping="Wrap" Text="{x:Bind ViewModel.Selected.Memo, Mode=TwoWay, FallbackValue=''}" />
                            <CalendarDatePicker Header="Bank date (clears the transaction)" Date="{x:Bind ViewModel.Selected.BankDateOffset, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="Transfers can't change amount or item. Delete the transfer and add it again instead."
                                       Visibility="{x:Bind ViewModel.Selected.IsTransfer, Mode=OneWay, FallbackValue=Collapsed}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="This transaction is split. Use Split to change its lines or amounts."
                                       Visibility="{x:Bind ViewModel.Selected.IsSplit, Mode=OneWay, FallbackValue=Collapsed}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Split…" Click="Split_Click" IsEnabled="{x:Bind ViewModel.Selected.CanSplit, Mode=OneWay, FallbackValue=true}" />
                                <Button Content="Delete" Click="Delete_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasMarkerSelected, Mode=OneWay}">
                <TextBlock Text="Month line" Style="{StaticResource SubtitleTextBlockStyle}" />
                <CalendarDatePicker x:Name="MarkerDateBox" Header="This month starts on" DateChanged="MarkerDate_Changed"
                                    Visibility="{x:Bind ViewModel.CanChangeSelectedMarker, Mode=OneWay}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8" Visibility="{x:Bind ViewModel.CanChangeSelectedMarker, Mode=OneWay}"
                           Text="Everything after this line belongs to this month. Drag the line, or use the buttons, to change where the month starts." />
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CanChangeSelectedMarker, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Move up" Click="MoveLineUp_Click" ToolTipService.ToolTip="Alt+Up" />
                        <Button Content="Move down" Click="MoveLineDown_Click" ToolTipService.ToolTip="Alt+Down" />
                    </StackPanel>
                    <Button Content="Delete this line" Click="DeleteLine_Click" />
                </StackPanel>
                <!-- The first month has no line to move. Which month it is can be chosen, since deleting transactions can change it. -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SelectedMarker.IsFirst, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                               Text="This is the first month, so there is no line to move. Choose which month it is. It can change by itself when transactions are deleted, so set it here whenever it is wrong." />
                    <ComboBox x:Name="FirstMonthBox" Header="Month" HorizontalAlignment="Stretch" SelectionChanged="FirstMonth_Changed" />
                    <NumberBox x:Name="FirstYearBox" Header="Year" Minimum="1950" Maximum="2100" SmallChange="1" LargeChange="1"
                               SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="FirstYear_Changed" />
                </StackPanel>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Padding="8" Click="CloseDetail_Click"
                    Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close the edit panel" ToolTipService.ToolTip="Close (Esc)">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
            <!-- Drag this edge to make the panel wider or narrower -->
            <local:ResizeGrip Tag="DetailWidth" HorizontalAlignment="Left" Margin="-20,0,0,0" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
            </Grid>
    </Grid>
</Page>
