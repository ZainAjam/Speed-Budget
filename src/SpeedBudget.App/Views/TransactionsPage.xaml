<Page x:Class="SpeedBudget.App.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:vm="using:SpeedBudget.App.ViewModels"
    xmlns:local="using:SpeedBudget.App.Views"
    KeyboardAcceleratorPlacementMode="Hidden" Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="NewMonth_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTransaction_Invoked" />
        <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="MoveLineUp_Invoked" />
        <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="MoveLineDown_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CloseDetail_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- The recorded transactions are a table: thin lines between cells and rows, and a shaded heading. -->
        <Style x:Key="CellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <SolidColorBrush x:Key="HeadingBrush" Color="{ThemeResource SystemAccentColorDark2}" />
        <Style x:Key="HeadingBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeadingBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,8" />
        </Style>
        <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="TransactionTemplate" x:DataType="vm:TransactionRow">
            <!-- A transaction is edited in place: the selected row swaps its text for boxes. Right-click offers Edit and Delete. -->
            <Grid Background="Transparent" ContextRequested="Row_ContextRequested">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Layout.DateColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.BankDateColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.CounterpartyColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="*" MinWidth="{x:Bind Layout.Memo, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.ItemColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.AccountColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.OutflowColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.InflowColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.ClearedColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CellBorder}">
                    <Grid>
                        <TextBlock Text="{x:Bind DateText, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" Visibility="{x:Bind NotEditing, Mode=OneWay}" />
                        <CalendarDatePicker Date="{x:Bind DateOffset, Mode=TwoWay}" Visibility="{x:Bind IsEditing, Mode=OneWay}"
                                            DateFormat="{}{day.integer} {month.abbreviated} {year.full}" MinWidth="0" HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Date" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CellBorder}">
                    <Grid>
                        <TextBlock Text="{x:Bind BankDateText, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" Opacity="0.85" Visibility="{x:Bind NotEditing, Mode=OneWay}" />
                        <CalendarDatePicker Date="{x:Bind BankDateOffset, Mode=TwoWay}" Visibility="{x:Bind IsEditing, Mode=OneWay}" PlaceholderText="Bank date"
                                            DateFormat="{}{day.integer} {month.abbreviated} {year.full}" MinWidth="0" HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Bank date (clears the transaction)" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CellBorder}">
                    <Grid>
                        <TextBlock Text="{x:Bind PayeeText, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ShowPayeeText, Mode=OneWay}" />
                        <ComboBox ItemsSource="{x:Bind Accounts}" DisplayMemberPath="Name" SelectedItem="{x:Bind OtherAccountChoice, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" MinWidth="0" Visibility="{x:Bind ShowTransferEditor, Mode=OneWay}" PlaceholderText="Other account"
                                  AutomationProperties.Name="The other account in this transfer" ToolTipService.ToolTip="The other account in this transfer" />
                        <local:PayeePicker ItemsSource="{x:Bind Payees}" Icons="{x:Bind PayeeIcons}" SelectedPayee="{x:Bind Payee, Mode=TwoWay}" CreateRequested="Payee_CreateRequested" EditRequested="Payee_EditRequested" DeleteRequested="Payee_DeleteRequested"
                                           Visibility="{x:Bind ShowPayeeEditor, Mode=OneWay}"
                                           ToolTipService.ToolTip="The counterparty is who the transaction is with: the person or business you paid, or who paid you." />
                    </Grid>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CellBorder}">
                    <Grid>
                        <TextBlock Text="{x:Bind Memo, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" Visibility="{x:Bind NotEditing, Mode=OneWay}" />
                        <TextBox Text="{x:Bind Memo, Mode=TwoWay}" PlaceholderText="Memo" MinWidth="0" Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Memo" />
                    </Grid>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CellBorder}" Visibility="{x:Bind Layout.ShowItem, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind ItemName, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" Visibility="{x:Bind ShowItemText, Mode=OneWay}"
                                   Tapped="ItemName_Tapped" />
                        <local:ItemPicker ItemsSource="{x:Bind ItemOptions}" SelectedItem="{x:Bind Item, Mode=TwoWay}" CreateRequested="Item_CreateRequested" AllowEdit="True" EditRequested="Item_EditRequested"
                                          AllowSplit="{x:Bind CanSplit}" SplitRequested="Item_SplitRequested" Visibility="{x:Bind ShowItemEditor, Mode=OneWay}"
                                          ValueOverride="{x:Bind SplitLabel, Mode=OneWay}" />
                    </Grid>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource CellBorder}" Visibility="{x:Bind Layout.ShowAccount, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind AccountName}" Margin="4,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" Visibility="{x:Bind NotEditing, Mode=OneWay}" />
                        <ComboBox ItemsSource="{x:Bind Accounts}" DisplayMemberPath="Name" SelectedItem="{x:Bind AccountChoice, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" MinWidth="0" Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Account" />
                    </Grid>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CellBorder}">
                    <Grid>
                        <TextBlock Text="{x:Bind OutflowText, Mode=OneWay}" Margin="4,4" HorizontalTextAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind ShowAmountText, Mode=OneWay}" />
                        <NumberBox app:Money.Format="True" Value="{x:Bind Outflow, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" MinWidth="0" PlaceholderText="0.00"
                                   Visibility="{x:Bind ShowAmountEditor, Mode=OneWay}" AutomationProperties.Name="Outflow" />
                    </Grid>
                </Border>
                <Border Grid.Column="7" Style="{StaticResource CellBorder}">
                    <Grid>
                        <TextBlock Text="{x:Bind InflowText, Mode=OneWay}" Margin="4,4" HorizontalTextAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind ShowAmountText, Mode=OneWay}" />
                        <NumberBox app:Money.Format="True" Value="{x:Bind Inflow, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" MinWidth="0" PlaceholderText="0.00"
                                   Visibility="{x:Bind ShowAmountEditor, Mode=OneWay}" AutomationProperties.Name="Inflow" />
                    </Grid>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource CellBorder}" Padding="0,2">
                    <CheckBox IsChecked="{x:Bind IsCleared, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                              AutomationProperties.Name="Cleared" />
                </Border>
                <!-- A pencil (yellow) turns edit mode on; while editing it is a tick (green) that saves the row. The bin is always there. -->
                <Border Grid.Column="9" Style="{StaticResource CellBorder}" BorderThickness="0,0,0,1" Padding="0,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Click="Edit_Click" Padding="7" Background="Transparent" BorderThickness="0" Visibility="{x:Bind NotEditing, Mode=OneWay}"
                                AutomationProperties.Name="Edit this transaction" ToolTipService.ToolTip="Edit this transaction">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#E9B72C" />
                        </Button>
                        <Button Click="Accept_Click" Padding="7" Background="Transparent" BorderThickness="0" Visibility="{x:Bind IsEditing, Mode=OneWay}"
                                AutomationProperties.Name="Save this transaction" ToolTipService.ToolTip="Save the changes">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#2FB36D" />
                        </Button>
                        <Button Click="Delete_Click" Padding="7" Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="Delete this transaction" ToolTipService.ToolTip="Delete this transaction">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MarkerTemplate" x:DataType="vm:MarkerRow">
            <StackPanel Padding="8,12,8,8" Spacing="4">
                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind LineAbove}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⠿" Opacity="0.6" VerticalAlignment="Center"
                               Visibility="{x:Bind CanDrag}" ToolTipService.ToolTip="Drag this line to change where the month starts" />
                    <TextBlock Text="{x:Bind Heading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind LineBelow}" />
            </StackPanel>
        </DataTemplate>

        <local:EntryTemplateSelector x:Key="EntrySelector"
                                     TransactionTemplate="{StaticResource TransactionTemplate}"
                                     MarkerTemplate="{StaticResource MarkerTemplate}" />
    </Page.Resources>

    <Grid Margin="32,24" RowSpacing="16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The account's name on the left, its balances in the middle and what kind of account it is on the right -->
        <Grid ColumnSpacing="16" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Cleared bank balance" />
                    <TextBlock Text="{x:Bind ViewModel.ClearedText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Uncleared transactions" />
                    <TextBlock Text="{x:Bind ViewModel.UnclearedText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Available bank balance" />
                    <TextBlock Text="{x:Bind ViewModel.AvailableText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <!-- Says whether this account is part of the budget or only tracked -->
            <Border Grid.Column="2" CornerRadius="14" Padding="14,5" VerticalAlignment="Center" Background="{x:Bind ViewModel.AccountBadgeBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.AccountBadgeBorderBrush, Mode=OneWay}" BorderThickness="1"
                    Visibility="{x:Bind ViewModel.ShowAccountBadge, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.AccountBadgeTip, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.AccountBadgeText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{x:Bind ViewModel.AccountBadgeTextBrush, Mode=OneWay}" />
            </Border>
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />

        <!-- 3. The recorded transactions -->
        <!-- The recorded transactions: what can be done in the middle (new rows go into the table; a new month starts a line in it) -->
        <Grid Grid.Row="2" ColumnSpacing="16" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Recorded transactions" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButtonStyle}" Click="NewTransaction_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New Transaction" />
                    </StackPanel>
                </Button>
                <Button Content="New Transfer" Click="Transfer_Click" />
                <Button Content="Start a new month" Click="NewMonth_Click" Visibility="{x:Bind ViewModel.CanStartMonth, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="16">
                <ComboBox Width="150" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" AutomationProperties.Name="Sort order">
                    <ComboBoxItem Content="Newest first" />
                    <ComboBoxItem Content="Oldest first" />
                </ComboBox>
                <TextBlock Text="{x:Bind ViewModel.DrillText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" MaxWidth="260" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="The transactions behind the figure you pressed on the budget" />
                <Button Content="Clear filters" Click="ClearFilters_Click" Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}" />
                <CheckBox Content="Hide cleared" IsChecked="{x:Bind ViewModel.HideCleared, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- The table fills the width on offer, and the Memo column takes the room its other columns do not need. If the window is too narrow for the columns, this area scrolls sideways. -->
        <ScrollViewer Grid.Row="3" x:Name="TableScroll" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" SizeChanged="TableScroll_SizeChanged">
        <Grid x:Name="TableRegion">
            <Border CornerRadius="6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="HeadingGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Layout.DateColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.BankDateColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.CounterpartyColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="*" MinWidth="{x:Bind Layout.Memo, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.ItemColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.AccountColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.OutflowColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.InflowColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.ClearedColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HeadingBorder}"><local:ColumnTitle FilterKey="Date" Title="Date" Help="The date the transaction happened. It decides which budget month it counts in." /></Border>
                        <Border Grid.Column="1" Style="{StaticResource HeadingBorder}"><local:ColumnTitle FilterKey="BankDate" Title="Bank date" Help="The date your bank processed it, if that is different from the date it happened. Optional." /></Border>
                        <Border Grid.Column="2" Style="{StaticResource HeadingBorder}"><local:ColumnTitle FilterKey="Counterparty" Title="Counterparty" Help="Who you paid, or who paid you: a shop, a person or an employer." /></Border>
                        <Border Grid.Column="3" Style="{StaticResource HeadingBorder}"><local:ColumnTitle FilterKey="Memo" Title="Memo" Help="A note to help you remember what the transaction was for." /></Border>
                        <Border Grid.Column="4" Style="{StaticResource HeadingBorder}" Visibility="{x:Bind Layout.ShowItem, Mode=OneWay}">
                            <local:ColumnTitle FilterKey="Item" Title="Budget item" Help="The budget item the spending comes out of, or the income goes into. A split lists several items. Transfers between two accounts that are both in your budget do not use one." />
                        </Border>
                        <Border Grid.Column="5" Style="{StaticResource HeadingBorder}" Visibility="{x:Bind ViewModel.ShowAccountColumn, Mode=OneWay}">
                            <local:ColumnTitle FilterKey="Account" Title="Account" Help="The bank account the transaction belongs to." />
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource HeadingBorder}"><local:ColumnTitle FilterKey="Outflow" Title="Outflow" Help="Money that left the account." HorizontalAlignment="Right" /></Border>
                        <Border Grid.Column="7" Style="{StaticResource HeadingBorder}"><local:ColumnTitle FilterKey="Inflow" Title="Inflow" Help="Money that came into the account." HorizontalAlignment="Right" /></Border>
                        <Border Grid.Column="8" Style="{StaticResource HeadingBorder}"><local:ColumnTitle FilterKey="Cleared" Title="Cleared" Help="Tick it once the transaction shows on your bank statement. Cleared transactions make up the cleared bank balance; the others are uncleared and only count towards the available balance." HorizontalAlignment="Center" /></Border>
                        <Border Grid.Column="9" Style="{StaticResource HeadingBorder}" BorderThickness="0" />
                        <!-- Drag the right edge of a heading to resize that column. Everything to its right moves along; the last column takes up what is left. -->
                        <local:ResizeGrip Grid.Column="0" Tag="Date" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="1" Tag="BankDate" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="2" Tag="Counterparty" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="3" Tag="Memo" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="4" Tag="Item" Visibility="{x:Bind Layout.ShowItem, Mode=OneWay}" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="5" Tag="Account" Visibility="{x:Bind Layout.ShowAccount, Mode=OneWay}" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="6" Tag="Outflow" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="7" Tag="Inflow" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="8" Tag="Cleared" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                    </Grid>
                    <ListView Grid.Row="1" x:Name="EntryList" ItemsSource="{x:Bind ViewModel.Rows}"
                              ItemTemplateSelector="{StaticResource EntrySelector}"
                              SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                              CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsStarting="List_DragItemsStarting" DragItemsCompleted="List_DragItemsCompleted">
                        <!-- No fade or slide when rows come and go: the table stays as it is, and a new row simply appears. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.Transitions>
                            <TransitionCollection />
                        </ListView.Transitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

        </Grid>
        </ScrollViewer>

            <!-- Expected transactions: a flyout that rises from the bar along the bottom. Things that are coming but have not happened yet are kept
                 here, and each moves into the table, with the date it happened, when it does. -->
            <Grid x:Name="ExpectedHost" Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Bottom" Height="340" Margin="-32,0,-32,-24" Padding="32,16,32,16"
                  Visibility="Collapsed" RowSpacing="10"
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="8,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Expected.CountText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                                   Text="Things you expect that have not happened yet. They do not change any balance or budget. When one happens, press the move icon and give the date." />
                    </StackPanel>
                    <Button Grid.Column="1" Click="ExpectedToggle_Click" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                            AutomationProperties.Name="Close expected transactions" ToolTipService.ToolTip="Close">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                </Grid>
                <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.Expected.HasMessage, Mode=OneWay}" Severity="Warning" IsClosable="False"
                         Message="{x:Bind ViewModel.Expected.Message, Mode=OneWay}" />
                <!-- Headings, then the boxes for a new expected transaction, then the list. All three share the same columns. -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                    <TextBlock Text="Counterparty" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="Memo" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Grid.Column="2" Text="Budget item" Width="200" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                               Visibility="{x:Bind ViewModel.Expected.ShowItem, Mode=OneWay}" />
                    <TextBlock Grid.Column="3" Text="Outflow" HorizontalTextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Grid.Column="4" Text="Inflow" HorizontalTextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                </Grid>
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                    <local:PayeePicker ItemsSource="{x:Bind ViewModel.Payees}" Icons="{x:Bind ViewModel.PayeeIcons}" SelectedPayee="{x:Bind ViewModel.Expected.FormPayee, Mode=TwoWay}"
                                       CreateRequested="Payee_CreateRequested" EditRequested="Payee_EditRequested" DeleteRequested="Payee_DeleteRequested" />
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Expected.FormMemo, Mode=TwoWay}" PlaceholderText="Memo" MinWidth="0" AutomationProperties.Name="Memo" />
                    <local:ItemPicker Grid.Column="2" Width="200" ItemsSource="{x:Bind ViewModel.ItemOptions}" SelectedItem="{x:Bind ViewModel.Expected.FormItem, Mode=TwoWay}"
                                      CreateRequested="Item_CreateRequested" AllowEdit="True" EditRequested="Item_EditRequested"
                                      Visibility="{x:Bind ViewModel.Expected.ShowItem, Mode=OneWay}" />
                    <NumberBox Grid.Column="3" app:Money.Format="True" Value="{x:Bind ViewModel.Expected.FormOutflow, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" MinWidth="0"
                               PlaceholderText="0.00" AutomationProperties.Name="Outflow" />
                    <NumberBox Grid.Column="4" app:Money.Format="True" Value="{x:Bind ViewModel.Expected.FormInflow, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" MinWidth="0"
                               PlaceholderText="0.00" AutomationProperties.Name="Inflow" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind ViewModel.Expected.SaveText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Click="ExpectedSave_Click" />
                        <Button Content="Cancel" Click="ExpectedCancel_Click" Visibility="{x:Bind ViewModel.Expected.CanCancelEdit, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="4" ItemsSource="{x:Bind ViewModel.Expected.Rows}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExpectedRow">
                            <Grid ColumnSpacing="8" Padding="0,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind PayeeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind MemoText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ItemText}" Width="200" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85"
                                           Visibility="{x:Bind ShowItem}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind OutflowText}" Foreground="{x:Bind OutflowBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind InflowText}" Foreground="{x:Bind InflowBrush}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                                    <Button Click="ExpectedHappened_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="It happened: move it to the recorded transactions" ToolTipService.ToolTip="It happened: move it to the recorded transactions">
                                        <FontIcon Glyph="&#xE8DE;" FontSize="14" Foreground="#2FB36D" />
                                    </Button>
                                    <Button Click="ExpectedEdit_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="Edit this expected transaction" ToolTipService.ToolTip="Edit">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#E9B72C" />
                                    </Button>
                                    <Button Click="ExpectedDelete_Click" Tag="{x:Bind}" Padding="7" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="Delete this expected transaction" ToolTipService.ToolTip="Delete">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- The bar along the bottom of an account's page that opens the Expected transactions flyout -->
            <Button x:Name="ExpectedBar" Grid.Row="4" HorizontalAlignment="Left" Click="ExpectedToggle_Click" Padding="14,8"
                    Visibility="{x:Bind ViewModel.Expected.ShowBar, Mode=OneWay}" AutomationProperties.Name="Expected transactions">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.Expected.CountText, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <!-- The month line panel floats over the table from the right edge. It slides in while a month line is selected. Transactions are edited in their own rows. -->
            <Grid x:Name="DetailHost" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,-32,-24"
                  Width="{x:Bind Layout.DetailWidth, Mode=OneWay}" Padding="20,16,20,16" IsHitTestVisible="False"
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasMarkerSelected, Mode=OneWay}">
                <TextBlock Text="Month line" Style="{StaticResource SubtitleTextBlockStyle}" />
                <CalendarDatePicker x:Name="MarkerDateBox" Header="This month starts on" DateChanged="MarkerDate_Changed"
                                    Visibility="{x:Bind ViewModel.CanChangeSelectedMarker, Mode=OneWay}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8" Visibility="{x:Bind ViewModel.CanChangeSelectedMarker, Mode=OneWay}"
                           Text="Everything after this line belongs to this month. Drag the line, or use the buttons, to change where the month starts." />
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CanChangeSelectedMarker, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Move up" Click="MoveLineUp_Click" />
                        <Button Content="Move down" Click="MoveLineDown_Click" />
                    </StackPanel>
                    <Button Content="Delete this line" Click="DeleteLine_Click" />
                </StackPanel>
                <!-- The first month is where the budget starts. Its date can be moved earlier (adding the months in between) or a little later. -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SelectedMarker.IsFirst, Mode=OneWay, FallbackValue=Collapsed}">
                    <CalendarDatePicker x:Name="StartDateBox" Header="Your budget starts on" DateChanged="StartDate_Changed" />
                    <TextBlock Text="The transactions that follow belong to the budget month of" TextWrapping="Wrap" />
                    <ComboBox x:Name="StartMonthBox" Header="Month" HorizontalAlignment="Stretch" SelectionChanged="StartMonth_Changed" />
                    <NumberBox x:Name="StartYearBox" Header="Year" Minimum="1950" Maximum="2100" SmallChange="1" LargeChange="1"
                               SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" ValueChanged="StartYear_Changed" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                               Text="The date is where the budget starts in the list, and nothing can be dated before it. The month is the budget month it counts as: a budget that starts on 24 October can be the start of November. Choose an earlier date or month to bring in older transactions: the months in between are added and what you have already budgeted stays where it is. The date can only move later while no transaction or month line comes before it." />
                </StackPanel>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Padding="8" Click="CloseDetail_Click"
                    Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close the edit panel" ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
            <!-- Drag this edge to make the panel wider or narrower -->
            <local:ResizeGrip Tag="DetailWidth" HorizontalAlignment="Left" Margin="-20,0,0,0" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
            </Grid>
    </Grid>
</Page>
