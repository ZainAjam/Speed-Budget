<Page x:Class="SpeedBudget.App.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:vm="using:SpeedBudget.App.ViewModels"
    xmlns:local="using:SpeedBudget.App.Views"
    KeyboardAcceleratorPlacementMode="Hidden" Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="NewMonth_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTransaction_Invoked" />
        <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="MoveLineUp_Invoked" />
        <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="MoveLineDown_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CloseDetail_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- The recorded transactions are a table: thin lines between cells and rows, and a shaded heading. -->
        <Style x:Key="CellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <SolidColorBrush x:Key="HeadingBrush" Color="{ThemeResource SystemAccentColorDark2}" />
        <Style x:Key="HeadingBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeadingBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,8" />
        </Style>
        <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="TransactionTemplate" x:DataType="vm:TransactionRow">
            <!-- A transaction is edited in place: the selected row swaps its text for boxes. Right-click offers Edit and Delete. -->
            <Grid Background="Transparent" ContextRequested="Row_ContextRequested" Tapped="Row_Tapped" Opacity="{x:Bind ExpectedOpacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Layout.DateColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.BankDateColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.CounterpartyColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="*" MinWidth="{x:Bind Layout.MemoMin, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.ItemColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.AccountColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.OutflowColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.InflowColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.ClearedColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CellBorder}" Padding="0" BorderThickness="{x:Bind Layout.CellLine, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Layout.SelectColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Tick it to select this transaction for deleting together with the other ticked ones -->
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}" Visibility="{x:Bind Layout.Selecting, Mode=OneWay}">
                            <CheckBox IsChecked="{x:Bind IsTicked, Mode=TwoWay}" MinWidth="0" MinHeight="0" Height="24" Padding="0" Width="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{x:Bind ShowTick}" AutomationProperties.Name="Select this transaction" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind DateText, Mode=OneWay}" FontStyle="{x:Bind ExpectedFontStyle, Mode=OneWay}" Margin="8,7" VerticalAlignment="Center" Visibility="{x:Bind NotEditing, Mode=OneWay}" />
                        <CalendarDatePicker x:Name="DateEditor" x:Load="{x:Bind IsEditing, Mode=OneWay}" Grid.Column="1" Date="{x:Bind DateOffset, Mode=TwoWay}" Visibility="{x:Bind IsEditing, Mode=OneWay}" Margin="4,3,24,3"
                                            DateFormat="{}{day.integer} {month.abbreviated} {year.full}" MinWidth="0" HorizontalAlignment="Stretch" PlaceholderText="No date yet"
                                            AutomationProperties.Name="Date" />
                        <!-- Leaves the transaction without a date: it is then expected, shown greyed out and in italics, and changes no balance until it gets a date -->
                        <Button x:Name="ClearDateButton" x:Load="{x:Bind ShowClearDate, Mode=OneWay}" Grid.Column="1" Visibility="{x:Bind ShowClearDate, Mode=OneWay}" Click="ClearDate_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="22" Height="26" Padding="0"
                                Margin="0,0,2,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Clear the date"
                                ToolTipService.ToolTip="Clear the date: the transaction is then expected, with no date yet, and changes no balance until it has one">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CellBorder}" BorderThickness="{x:Bind Layout.CellLine, Mode=OneWay}" Visibility="{x:Bind Layout.BankDateVisible, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind BankDateText, Mode=OneWay}" FontStyle="{x:Bind ExpectedFontStyle, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" Opacity="0.85" Visibility="{x:Bind NotEditing, Mode=OneWay}" />
                        <CalendarDatePicker x:Name="BankDateEditor" x:Load="{x:Bind IsEditing, Mode=OneWay}" Date="{x:Bind BankDateOffset, Mode=TwoWay}" Visibility="{x:Bind IsEditing, Mode=OneWay}" PlaceholderText="Bank date"
                                            DateFormat="{}{day.integer} {month.abbreviated} {year.full}" MinWidth="0" HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Bank date (clears the transaction)" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CellBorder}" BorderThickness="{x:Bind Layout.CellLine, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind PayeeText, Mode=OneWay}" FontStyle="{x:Bind ExpectedFontStyle, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ShowPayeeText, Mode=OneWay}" />
                        <ComboBox x:Name="TransferEditor" x:Load="{x:Bind ShowTransferEditor, Mode=OneWay}" ItemsSource="{x:Bind Accounts}" DisplayMemberPath="Name" SelectedItem="{x:Bind OtherAccountChoice, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" MinWidth="0" Visibility="{x:Bind ShowTransferEditor, Mode=OneWay}" PlaceholderText="Other account"
                                  AutomationProperties.Name="The other account in this transfer" ToolTipService.ToolTip="The other account in this transfer" />
                        <local:PayeePicker x:Name="PayeeEditor" x:Load="{x:Bind ShowPayeeEditor, Mode=OneWay}" ItemsSource="{x:Bind Payees}" Icons="{x:Bind PayeeIcons}" SelectedPayee="{x:Bind Payee, Mode=TwoWay}" CreateRequested="Payee_CreateRequested" EditRequested="Payee_EditRequested" DeleteRequested="Payee_DeleteRequested"
                                           Visibility="{x:Bind ShowPayeeEditor, Mode=OneWay}"
                                           ToolTipService.ToolTip="The counterparty is who the transaction is with: the person or business you paid, or who paid you." />
                    </Grid>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CellBorder}" BorderThickness="{x:Bind Layout.CellLine, Mode=OneWay}">
                    <Grid>
                        <Grid Visibility="{x:Bind Layout.NotMemoIcon, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Memo, Mode=OneWay}" FontStyle="{x:Bind ExpectedFontStyle, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" Visibility="{x:Bind NotEditing, Mode=OneWay}" />
                            <TextBox x:Name="MemoEditor" x:Load="{x:Bind IsEditing, Mode=OneWay}" Text="{x:Bind Memo, Mode=TwoWay}" PlaceholderText="Memo" MinWidth="0" Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Memo" />
                        </Grid>
                        <!-- In a narrow window the memo is only an icon: its text is the tooltip, and a click opens it in a small box to read or change -->
                        <Button Visibility="{x:Bind Layout.MemoIcon, Mode=OneWay}" Padding="6" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Opacity="{x:Bind MemoIconOpacity, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind MemoTip, Mode=OneWay}" AutomationProperties.Name="Memo" Click="MemoIcon_Click">
                            <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CellBorder}" BorderThickness="{x:Bind Layout.CellLine, Mode=OneWay}" Visibility="{x:Bind Layout.ShowItem, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind ItemName, Mode=OneWay}" FontStyle="{x:Bind ExpectedFontStyle, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" Visibility="{x:Bind ShowItemText, Mode=OneWay}"
                                   Tapped="ItemName_Tapped" />
                        <local:ItemPicker x:Name="ItemEditor" x:Load="{x:Bind ShowItemEditor, Mode=OneWay}" ItemsSource="{x:Bind ItemOptions}" SelectedItem="{x:Bind Item, Mode=TwoWay}" CreateRequested="Item_CreateRequested" AllowEdit="True" EditRequested="Item_EditRequested"
                                          AllowSplit="{x:Bind CanSplit}" SplitRequested="Item_SplitRequested" Visibility="{x:Bind ShowItemEditor, Mode=OneWay}"
                                          ValueOverride="{x:Bind SplitLabel, Mode=OneWay}" />
                    </Grid>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource CellBorder}" BorderThickness="{x:Bind Layout.CellLine, Mode=OneWay}" Visibility="{x:Bind Layout.AccountVisible, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind AccountName}" FontStyle="{x:Bind ExpectedFontStyle, Mode=OneWay}" Margin="4,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" Visibility="{x:Bind NotEditing, Mode=OneWay}" />
                        <ComboBox x:Name="AccountEditor" x:Load="{x:Bind IsEditing, Mode=OneWay}" ItemsSource="{x:Bind Accounts}" DisplayMemberPath="Name" SelectedItem="{x:Bind AccountChoice, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" MinWidth="0" Visibility="{x:Bind IsEditing, Mode=OneWay}" AutomationProperties.Name="Account" />
                    </Grid>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CellBorder}" BorderThickness="{x:Bind Layout.CellLine, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind OutflowText, Mode=OneWay}" FontStyle="{x:Bind ExpectedFontStyle, Mode=OneWay}" Margin="4,4" HorizontalTextAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind ShowAmountText, Mode=OneWay}" />
                        <NumberBox x:Name="OutflowEditor" x:Load="{x:Bind ShowAmountEditor, Mode=OneWay}" app:Money.Format="True" Value="{x:Bind Outflow, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" MinWidth="0" PlaceholderText="0.00"
                                   Visibility="{x:Bind ShowAmountEditor, Mode=OneWay}" AutomationProperties.Name="Outflow" />
                    </Grid>
                </Border>
                <Border Grid.Column="7" Style="{StaticResource CellBorder}" BorderThickness="{x:Bind Layout.CellLine, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind InflowText, Mode=OneWay}" FontStyle="{x:Bind ExpectedFontStyle, Mode=OneWay}" Margin="4,4" HorizontalTextAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind ShowAmountText, Mode=OneWay}" />
                        <NumberBox x:Name="InflowEditor" x:Load="{x:Bind ShowAmountEditor, Mode=OneWay}" app:Money.Format="True" Value="{x:Bind Inflow, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" MinWidth="0" PlaceholderText="0.00"
                                   Visibility="{x:Bind ShowAmountEditor, Mode=OneWay}" AutomationProperties.Name="Inflow" />
                    </Grid>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource CellBorder}" BorderThickness="{x:Bind Layout.CellLine, Mode=OneWay}" Padding="0,2">
                    <CheckBox IsChecked="{x:Bind IsCleared, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                              AutomationProperties.Name="Cleared" />
                </Border>
                <!-- A pencil (yellow) turns edit mode on; while editing it is a tick (green) that saves the row. The bin is always there. -->
                <Border Grid.Column="9" Style="{StaticResource CellBorder}" BorderThickness="{x:Bind Layout.ActionLine, Mode=OneWay}" Padding="0,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{x:Bind Layout.NotSelecting, Mode=OneWay}">
                        <Button Click="Edit_Click" Padding="7" Background="Transparent" BorderThickness="0" Visibility="{x:Bind NotEditing, Mode=OneWay}"
                                AutomationProperties.Name="Edit this transaction" ToolTipService.ToolTip="Edit this transaction">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#E9B72C" />
                        </Button>
                        <Button Click="Accept_Click" Padding="7" Background="Transparent" BorderThickness="0" Visibility="{x:Bind IsEditing, Mode=OneWay}"
                                AutomationProperties.Name="Save this transaction" ToolTipService.ToolTip="Save the changes">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#2FB36D" />
                        </Button>
                        <Button Click="Delete_Click" Padding="7" Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="Delete this transaction" ToolTipService.ToolTip="Delete this transaction">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MarkerTemplate" x:DataType="vm:MarkerRow">
            <StackPanel Padding="8,12,8,8" Spacing="4" Background="Transparent" Tapped="Marker_Tapped">
                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind LineAbove}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⠿" Opacity="0.6" VerticalAlignment="Center"
                               Visibility="{x:Bind CanDrag}" ToolTipService.ToolTip="Drag this line to change where the month starts" />
                    <!-- One plain sentence: which budget month starts, and on what date. -->
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                        <Run Text="{x:Bind Label}" FontWeight="Bold" /><Run Text=" budget month starts here" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>
                <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind LineBelow}" />
            </StackPanel>
        </DataTemplate>

        <local:EntryTemplateSelector x:Key="EntrySelector"
                                     TransactionTemplate="{StaticResource TransactionTemplate}"
                                     MarkerTemplate="{StaticResource MarkerTemplate}" />
    </Page.Resources>

    <Grid x:Name="PageRoot" Margin="32,24" RowSpacing="16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The account's name on the left, its balances in the middle and what kind of account it is on the right -->
        <!-- This row and the one of buttons below it shrink to fit a narrow window, and keep their places (see ShrinkBox). -->
        <local:ShrinkBox>
        <Grid ColumnSpacing="16" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Cleared bank balance" />
                    <TextBlock Text="{x:Bind ViewModel.ClearedText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Uncleared transactions" />
                    <TextBlock Text="{x:Bind ViewModel.UnclearedText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="Available bank balance" />
                    <TextBlock Text="{x:Bind ViewModel.AvailableText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <!-- Says whether this account is part of the budget or only tracked -->
            <Border Grid.Column="2" CornerRadius="14" Padding="14,5" VerticalAlignment="Center" Background="{x:Bind ViewModel.AccountBadgeBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.AccountBadgeBorderBrush, Mode=OneWay}" BorderThickness="1"
                    Visibility="{x:Bind ViewModel.ShowAccountBadge, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.AccountBadgeTip, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.AccountBadgeText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{x:Bind ViewModel.AccountBadgeTextBrush, Mode=OneWay}" />
            </Border>
        </Grid>
        </local:ShrinkBox>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />

        <!-- 3. The recorded transactions -->
        <!-- The recorded transactions: what can be done in the middle (new rows go into the table; a new month starts a line in it) -->
        <local:ShrinkBox Grid.Row="2">
        <Grid ColumnSpacing="16" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButtonStyle}" Click="NewTransaction_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New Transaction" />
                    </StackPanel>
                </Button>
                <Button Content="New Transfer" Click="Transfer_Click" />
                <Button Content="New Month" Click="NewMonth_Click" Visibility="{x:Bind ViewModel.CanStartMonth, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                <ComboBox Width="170" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" AutomationProperties.Name="Sort order">
                    <ComboBoxItem Content="Show newest first" />
                    <ComboBoxItem Content="Show oldest first" />
                </ComboBox>
                <TextBlock Text="{x:Bind ViewModel.DrillText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" MaxWidth="260" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="The transactions behind the figure you pressed on the budget" />
                <Button Content="Clear filters" Click="ClearFilters_Click" Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}" />
                <CheckBox Content="Hide cleared" IsChecked="{x:Bind ViewModel.HideCleared, Mode=TwoWay}" />
                <!-- The overflow menu: import from and export to Excel -->
                <Button AutomationProperties.Name="More" ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Import from Excel…" Click="ImportExcel_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Export to Excel…" Click="ExportExcel_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        </local:ShrinkBox>

        <!-- The table fills the width on offer, and the Memo column takes the room its other columns do not need. If the window is too narrow for the columns, this area scrolls sideways. -->
        <Grid Grid.Row="3">
        <local:ZoomBox x:Name="TableZoom">
        <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" SizeChanged="TableScroll_SizeChanged">
        <Grid x:Name="TableRegion">
            <Border x:Name="TableFrame" CornerRadius="6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="HeadingGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Layout.DateColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.BankDateColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.CounterpartyColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="*" MinWidth="{x:Bind Layout.MemoMin, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.ItemColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.AccountColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.OutflowColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.InflowColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.ClearedColumn, Mode=OneWay}" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HeadingBorder}" Padding="0" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind Layout.SelectColumn, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}" Visibility="{x:Bind Layout.Selecting, Mode=OneWay}">
                                    <CheckBox x:Name="TickAllBox" MinWidth="0" MinHeight="0" Height="24" Padding="0" Width="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Click="TickAll_Click" AutomationProperties.Name="Select all transactions" ToolTipService.ToolTip="Tick all the transactions, or none" />
                                </Border>
                                <local:ColumnTitle Grid.Column="1" Margin="8,8,8,8" FilterKey="Date" Title="Date" Help="The date the transaction happened. It decides which budget month it counts in." />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}" Visibility="{x:Bind Layout.BankDateVisible, Mode=OneWay}"><local:ColumnTitle FilterKey="BankDate" Title="Bank date" Help="The date your bank processed it, if that is different from the date it happened. Optional." /></Border>
                        <Border Grid.Column="2" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}"><local:ColumnTitle FilterKey="Counterparty" Title="Counterparty" Help="Who you paid, or who paid you: a shop, a person or an employer." /></Border>
                        <Border Grid.Column="3" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}"><local:ColumnTitle FilterKey="Memo" Title="Memo" Help="A note to help you remember what the transaction was for." /></Border>
                        <Border Grid.Column="4" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}" Visibility="{x:Bind Layout.ShowItem, Mode=OneWay}">
                            <local:ColumnTitle FilterKey="Item" Title="Budget item" Help="The budget item the spending comes out of, or the income goes into. A split lists several items. Transfers between two accounts that are both in your budget do not use one." />
                        </Border>
                        <Border Grid.Column="5" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}" Visibility="{x:Bind Layout.AccountVisible, Mode=OneWay}">
                            <local:ColumnTitle FilterKey="Account" Title="Account" Help="The bank account the transaction belongs to." />
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}"><local:ColumnTitle FilterKey="Outflow" Title="Outflow" Help="Money that left the account." HorizontalAlignment="Right" /></Border>
                        <Border Grid.Column="7" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}"><local:ColumnTitle FilterKey="Inflow" Title="Inflow" Help="Money that came into the account." HorizontalAlignment="Right" /></Border>
                        <Border Grid.Column="8" Style="{StaticResource HeadingBorder}" BorderThickness="{x:Bind Layout.HeadingLine, Mode=OneWay}"><local:ColumnTitle x:Name="ClearedHeading" FilterKey="Cleared" Title="Cleared" Help="Tick it once the transaction shows on your bank statement. Cleared transactions make up the cleared bank balance; the others are uncleared and only count towards the available balance." HorizontalAlignment="Center" /></Border>
                        <Border Grid.Column="9" Style="{StaticResource HeadingBorder}" BorderThickness="0" />
                        <!-- Drag the right edge of a heading to resize that column. Everything to its right moves along; the last column takes up what is left. -->
                        <local:ResizeGrip Grid.Column="0" Tag="Date" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="1" Tag="BankDate" Visibility="{x:Bind Layout.BankDateVisible, Mode=OneWay}" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="2" Tag="Counterparty" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="3" Tag="Memo" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="4" Tag="Item" Visibility="{x:Bind Layout.ShowItem, Mode=OneWay}" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="5" Tag="Account" Visibility="{x:Bind Layout.AccountVisible, Mode=OneWay}" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="6" Tag="Outflow" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="7" Tag="Inflow" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                        <local:ResizeGrip Grid.Column="8" Tag="Cleared" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
                    </Grid>
                    <ListView Grid.Row="1" x:Name="EntryList" ItemsSource="{x:Bind ViewModel.Rows}" ContainerContentChanging="EntryList_ContainerContentChanging"
                              ItemTemplateSelector="{StaticResource EntrySelector}"
                              SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                              CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsStarting="List_DragItemsStarting" DragItemsCompleted="List_DragItemsCompleted">
                        <!-- No fade or slide when rows come and go: the table stays as it is, and a new row simply appears. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.Transitions>
                            <TransitionCollection />
                        </ListView.Transitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

        </Grid>
        </ScrollViewer>
        </local:ZoomBox>
        <local:JumpToLatestButton x:Name="JumpButton" />
        </Grid>

            <!-- The month line panel floats over the table from the right edge. It slides in while a month line is selected. Transactions are edited in their own rows. -->
            <Grid x:Name="DetailHost" Grid.Row="3" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,-32,-24"
                  Width="{x:Bind Layout.DetailWidth, Mode=OneWay}" Padding="20,16,20,16" IsHitTestVisible="False">
            <Rectangle Margin="-20,-16,-20,-16" Fill="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" RadiusX="8" RadiusY="8" IsHitTestVisible="False" />
            <Border Margin="-20,-16,-20,-16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" IsHitTestVisible="False" />
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasMarkerSelected, Mode=OneWay}">
                <TextBlock Text="Month line" Style="{StaticResource SubtitleTextBlockStyle}" />
                <!-- Looking: nothing here changes anything. The pencil switches to editing. -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowMarkerView, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.SelectedMarker.Label, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedMarker.ViewText, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>

                <!-- Editing: the boxes change nothing until Save is pressed. A line has no date: only the month it stands for. -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsMarkerEditing, Mode=OneWay}">
                    <TextBlock Text="The month this line starts" TextWrapping="Wrap" />
                    <ComboBox x:Name="StartMonthBox" Header="Month" HorizontalAlignment="Stretch" />
                    <NumberBox x:Name="StartYearBox" Header="Year" Minimum="1950" Maximum="2100" SmallChange="1" LargeChange="1"
                               SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                               Text="Everything after this line, down to the next month line, counts towards this month. The line's place in the list decides that, not a date." />
                </StackPanel>
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CanChangeSelectedMarker, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Move up" Click="MoveLineUp_Click" />
                        <Button Content="Move down" Click="MoveLineDown_Click" />
                    </StackPanel>
                    <Button Content="Delete this line" Click="DeleteLine_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsMarkerEditing, Mode=OneWay}">
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveMarker_Click" />
                    <Button Content="Cancel" Click="CancelMarkerEdit_Click" />
                </StackPanel>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,32,0" Padding="8" Click="EditMarker_Click"
                    Visibility="{x:Bind ViewModel.ShowMarkerEditButton, Mode=OneWay}"
                    Background="Transparent" BorderThickness="0" AutomationProperties.Name="Edit this month line" ToolTipService.ToolTip="Edit">
                <FontIcon Glyph="&#xE70F;" FontSize="12" />
            </Button>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Padding="8" Click="CloseDetail_Click"
                    Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close the edit panel" ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
            <!-- Drag this edge to make the panel wider or narrower -->
            <local:ResizeGrip Tag="DetailWidth" HorizontalAlignment="Left" Margin="-20,0,0,0" Started="Grip_Started" Moved="Grip_Moved" Completed="Grip_Completed" />
            </Grid>
    </Grid>
</Page>
