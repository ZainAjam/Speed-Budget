<ContentDialog x:Class="SpeedBudget.App.Views.TransferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:local="using:SpeedBudget.App.Views"
    Title="Add transfer" PrimaryButtonText="Add" CloseButtonText="Cancel" DefaultButton="Primary"
    PrimaryButtonClick="Add_Click">
    <StackPanel Spacing="12" MinWidth="380">
        <ComboBox x:Name="FromBox" Header="From account" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                  SelectionChanged="Accounts_SelectionChanged" />
        <ComboBox x:Name="ToBox" Header="To account" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                  SelectionChanged="Accounts_SelectionChanged" />
        <CalendarDatePicker x:Name="DateBox" Header="Date" />
        <NumberBox app:Money.Format="True" x:Name="AmountBox" Header="Amount (R)" PlaceholderText="0.00" SpinButtonPlacementMode="Hidden" />
        <local:ItemPicker x:Name="ItemBox" Header="Budget item" Visibility="Collapsed" AllowCreate="False" />
        <TextBlock x:Name="ItemHelp" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBox x:Name="MemoBox" Header="Memo" PlaceholderText="Optional" />
        <TextBlock x:Name="Error" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
