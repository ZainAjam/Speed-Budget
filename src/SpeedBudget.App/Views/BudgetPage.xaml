<Page x:Class="SpeedBudget.App.Views.BudgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:vm="using:SpeedBudget.App.ViewModels"
    SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <!-- Every row is a fixed height, so the name column and each month column line up row for row. -->

        <DataTemplate x:Key="IncomeNameTemplate" x:DataType="vm:BudgetLine">
            <Grid Height="40" Padding="12,0" Visibility="{x:Bind IsVisible, Mode=OneWay}" Background="Transparent" ContextRequested="Line_ContextRequested">
                <TextBlock Text="{x:Bind Name}" Margin="{x:Bind Indent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OutflowNameTemplate" x:DataType="vm:BudgetLine">
            <Grid Height="40" Padding="4,0,12,0" Visibility="{x:Bind IsVisible, Mode=OneWay}" Background="{x:Bind HighlightBrush, Mode=OneWay}"
                  CanDrag="{x:Bind IsItem}" AllowDrop="True" DragStarting="Line_DragStarting" DragOver="Line_DragOver" Drop="Line_Drop"
                  ContextRequested="Line_ContextRequested">
                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsHeader}">
                    <Button Click="Chevron_Click" Tag="{x:Bind}" Padding="6" Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Fold or unfold this group">
                        <FontIcon Glyph="{x:Bind app:Glyphs.Chevron(Group.IsExpanded), Mode=OneWay}" FontSize="12" />
                    </Button>
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Click="AddItemToGroup_Click" Tag="{x:Bind}" Padding="6" Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Add a budget item to this group" ToolTipService.ToolTip="Add a budget item to this group">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{x:Bind Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind IsItem}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SummaryLabelTemplate" x:DataType="vm:SummaryLabel">
            <Grid Height="{x:Bind app:Glyphs.SummaryRowHeight(IsStrong)}" Padding="12,0,4,0" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Text}" VerticalAlignment="Center" Opacity="0.85" FontWeight="{x:Bind app:Glyphs.Weight(IsStrong)}" />
                <!-- Shows or hides the other monthly figures; only "Available to budget" stays in view when they are hidden -->
                <Button Grid.Column="1" Click="SummaryToggle_Click" Visibility="{x:Bind IsStrong}" Padding="8" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="Show or hide the monthly figures" ToolTipService.ToolTip="Show or hide the monthly figures">
                    <FontIcon Glyph="{x:Bind ToggleGlyph, Mode=OneWay}" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SummaryCellTemplate" x:DataType="vm:SummaryCell">
            <Grid Height="{x:Bind app:Glyphs.SummaryRowHeight(IsStrong)}" Padding="8,0" Visibility="{x:Bind IsVisible, Mode=OneWay}"
                  Background="Transparent" ContextRequested="Available_ContextRequested">
                <TextBlock Text="{x:Bind Text, Mode=OneWay}" Foreground="{x:Bind Brush, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalTextAlignment="Center"
                           VerticalAlignment="Center" FontWeight="{x:Bind app:Glyphs.Weight(IsStrong)}" FontSize="{x:Bind app:Glyphs.SummarySize(IsStrong)}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IncomeCellTemplate" x:DataType="vm:IncomeCell">
            <Grid Height="40" Padding="8,0" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{x:Bind ReceivedText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border Grid.Column="2" Background="Transparent" ContextRequested="Income_ContextRequested">
                    <TextBlock Text="{x:Bind AvailableText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OutflowCellTemplate" x:DataType="vm:OutflowCell">
            <Grid Height="40" Padding="8,0" Visibility="{x:Bind IsVisible, Mode=OneWay}" Background="{x:Bind Line.HighlightBrush, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <NumberBox app:Money.Format="True" PreviewKeyDown="Budgeted_PreviewKeyDown" GotFocus="Budgeted_GotFocus" Value="{x:Bind Budgeted, Mode=TwoWay}" SpinButtonPlacementMode="Hidden"
                           Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="Budgeted" LostFocus="Budgeted_LostFocus" Visibility="{x:Bind Line.IsItem}" />
                <!-- A group's heading row shows no figures: only the items under it do -->
                <TextBlock Grid.Column="1" Text="{x:Bind SpentText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{x:Bind Line.IsItem}" />
                <!-- Right-click moves budget between items (or covers an overspent one) -->
                <Border Grid.Column="2" Background="Transparent" ContextRequested="Left_ContextRequested" Visibility="{x:Bind Line.IsItem}">
                    <TextBlock Text="{x:Bind LeftText, Mode=OneWay}" Foreground="{x:Bind LeftBrush, Mode=OneWay}"
                               HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- "Available to budget", kept in view beside the month headings while the summary block is hidden -->
        <DataTemplate x:Key="FrozenAvailableTemplate" x:DataType="vm:MonthColumn">
            <ContentControl Width="{x:Bind Width}" Content="{x:Bind AvailableCell}" ContentTemplate="{StaticResource SummaryCellTemplate}"
                            HorizontalContentAlignment="Stretch" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="2,0,0,0" IsTabStop="False" />
        </DataTemplate>

        <!-- The column titles of the cash inflow and cash outflow rows, kept in view once the section's own title has scrolled away -->
        <DataTemplate x:Key="FrozenInflowTitlesTemplate" x:DataType="vm:MonthColumn">
            <Grid Width="{x:Bind Width}" Height="30" Padding="8,0,8,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="2,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Received" HorizontalTextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Grid.Column="2" Text="Available now" HorizontalTextAlignment="Right" VerticalAlignment="Bottom"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FrozenOutflowTitlesTemplate" x:DataType="vm:MonthColumn">
            <Grid Width="{x:Bind Width}" Height="30" Padding="8,0,8,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="2,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Budgeted" HorizontalTextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="Spent" HorizontalTextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Grid.Column="2" Text="Left" HorizontalTextAlignment="Right" VerticalAlignment="Bottom"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MonthTemplate" x:DataType="vm:MonthColumn">
            <StackPanel Width="{x:Bind Width}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="2,0,0,0">
                <!-- Summary block, shaded differently from the cash blocks -->
                <Border Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" Padding="0,6" Visibility="{x:Bind SummaryOpen, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind Summary}" ItemTemplate="{StaticResource SummaryCellTemplate}" />
                </Border>
                <Border Height="16" />
                <!-- Cash inflow -->
                <Grid Height="48" Padding="8,0,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Received" HorizontalTextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Grid.Column="2" Text="Available now" HorizontalTextAlignment="Right" VerticalAlignment="Bottom"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                </Grid>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="0,6">
                    <ItemsControl ItemsSource="{x:Bind Income}" ItemTemplate="{StaticResource IncomeCellTemplate}" />
                </Border>
                <Border Height="16" />
                <!-- Cash outflow -->
                <Grid Height="48" Padding="8,0,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Budgeted" HorizontalTextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="Spent" HorizontalTextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock Grid.Column="2" Text="Left" HorizontalTextAlignment="Right" VerticalAlignment="Bottom"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                </Grid>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="0,6">
                    <ItemsControl ItemsSource="{x:Bind Outflow}" ItemTemplate="{StaticResource OutflowCellTemplate}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- The month headings sit above the scrolling part of the page, so they stay in view while scrolling. -->
        <DataTemplate x:Key="MonthHeaderTemplate" x:DataType="vm:MonthColumn">
            <Grid Width="{x:Bind Width}" Height="56" Padding="12,0,8,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="2,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="2">
                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalTextAlignment="Center" />
                    <TextBlock Text="Planned: no transactions yet" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalTextAlignment="Center"
                               Visibility="{x:Bind IsPlanned, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Click="MonthMenu_Click" Tag="{x:Bind}" Background="Transparent" BorderThickness="0"
                        Visibility="{x:Bind HasPrevious}" AutomationProperties.Name="Month options" ToolTipService.ToolTip="Fill this month's budget">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32,24">
        <StackPanel x:Name="Welcome" Visibility="Collapsed" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Welcome to Speed Budget" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                       Text="Let's set up your budget. A short guided setup creates your bank accounts, budget groups and items, and the counterparties you deal with most. You can change all of it afterwards." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Set up my budget" Style="{StaticResource AccentButtonStyle}" Click="Setup_Click" />
                <Button Content="Start empty" Click="Empty_Click" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="The setup offers a typical household list, a short minimal list, or an empty start. You can run it again later from App Settings." />
        </StackPanel>

        <Grid x:Name="BudgetContent" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Budget" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <!-- Month navigation, centred along the top of the page -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="&#xE76B;" FontFamily="{StaticResource SymbolThemeFontFamily}" Click="Back_Click"
                            IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" AutomationProperties.Name="Earlier months" ToolTipService.ToolTip="Earlier months. At the first month this adds an earlier month." />
                    <!-- Pressing the months opens a month and year picker to jump straight to one -->
                    <Button x:Name="RangeButton" MinWidth="240" Padding="8,4" Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Jump to a month" ToolTipService.ToolTip="Jump to a month">
                        <TextBlock Text="{x:Bind ViewModel.RangeText, Mode=OneWay}" TextAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button.Flyout>
                            <Flyout Opening="JumpFlyout_Opening">
                                <StackPanel Spacing="10" MinWidth="320">
                                    <TextBlock Text="Jump to a month" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ComboBox x:Name="JumpMonthBox" Header="Month" Width="170" />
                                        <NumberBox x:Name="JumpYearBox" Header="Year" Width="130" Minimum="1950" Maximum="2100" SmallChange="1" LargeChange="1"
                                                   SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                    </StackPanel>
                                    <TextBlock x:Name="JumpMessage" Visibility="Collapsed" TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button Content="Go to this month" Style="{StaticResource AccentButtonStyle}" Click="JumpGo_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="&#xE76C;" FontFamily="{StaticResource SymbolThemeFontFamily}" Click="Forward_Click"
                            IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}" AutomationProperties.Name="Later months" ToolTipService.ToolTip="Later months" />
                    <Grid Width="36">
                        <Button Visibility="{x:Bind ViewModel.ShowJumpToCurrent, Mode=OneWay}" Click="JumpToCurrent_Click" Padding="8"
                                AutomationProperties.Name="Back to the current month" ToolTipService.ToolTip="Back to the current month">
                            <FontIcon Glyph="&#xE787;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="SingleButton" Checked="SingleMonth_Checked" Unchecked="SingleMonth_Unchecked" IsChecked="{x:Bind ViewModel.ShowSingleMonth, Mode=OneWay}"
                                  AutomationProperties.Name="Show one month at a time" ToolTipService.ToolTip="Show one month at a time (more room for item names)">
                        <FontIcon Glyph="&#xE7C3;" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="ManyButton" Checked="ManyMonths_Checked" Unchecked="ManyMonths_Unchecked" IsChecked="{x:Bind ViewModel.ShowManyMonths, Mode=OneWay}"
                                  AutomationProperties.Name="Show as many months as fit" ToolTipService.ToolTip="Show as many months as fit across the screen">
                        <!-- Two pages stacked: the one-month page, with a second page showing behind it -->
                        <Grid Width="22" Height="22">
                            <FontIcon Glyph="&#xE7C3;" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.55">
                                <FontIcon.Clip><RectangleGeometry Rect="0,0,20,5" /></FontIcon.Clip>
                            </FontIcon>
                            <FontIcon Glyph="&#xE7C3;" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.55">
                                <FontIcon.Clip><RectangleGeometry Rect="0,0,5,20" /></FontIcon.Clip>
                            </FontIcon>
                            <FontIcon Glyph="&#xE7C3;" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning"
                     Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />

            <!-- Same columns as the body below, so each heading sits over its month. The right margin matches the scroll bar's. -->
            <Grid Grid.Row="2" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}" ItemTemplate="{StaticResource MonthHeaderTemplate}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- While the summary block is hidden, "Available to budget" stays here with the month headings -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" Padding="0,6"
                        Visibility="{x:Bind ViewModel.SummaryClosed, Mode=OneWay}" />
                <ContentControl Grid.Row="1" Content="{x:Bind vm:BudgetViewModel.AvailableLabel}" ContentTemplate="{StaticResource SummaryLabelTemplate}"
                                HorizontalContentAlignment="Stretch" IsTabStop="False" Margin="0,6" Visibility="{x:Bind ViewModel.SummaryClosed, Mode=OneWay}" />
                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}" ItemTemplate="{StaticResource FrozenAvailableTemplate}"
                              HorizontalAlignment="Right" Margin="0,6" Visibility="{x:Bind ViewModel.SummaryClosed, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- Under the headings, the titles of the rows being scrolled through -->
                <TextBlock Grid.Row="2" Text="Cash Inflow" Margin="12,0,0,4" VerticalAlignment="Bottom" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.FrozenInflow, Mode=OneWay}" />
                <TextBlock Grid.Row="2" Text="Cash Outflow" Margin="12,0,0,4" VerticalAlignment="Bottom" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind ViewModel.FrozenOutflow, Mode=OneWay}" />
                <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}" ItemTemplate="{StaticResource FrozenInflowTitlesTemplate}"
                              HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.FrozenInflow, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}" ItemTemplate="{StaticResource FrozenOutflowTitlesTemplate}"
                              HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.FrozenOutflow, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <ScrollViewer x:Name="BudgetScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" IsTabStop="True" UseSystemFocusVisuals="False" ViewChanged="BudgetScroll_ViewChanged"
                          FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0">
                <StackPanel>
                    <TextBlock x:Name="EmptyHint" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12"
                               Text="There are no budget items yet. Add some under Budget Items." />
                    <!-- The names take whatever width is left; the months sit against the right-hand edge of the page. -->
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Names column -->
                        <StackPanel Grid.Column="0">
                            <Border x:Name="SummaryBlock" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" Padding="0,6" Visibility="{x:Bind ViewModel.SummaryOpen, Mode=OneWay}">
                                <ItemsControl x:Name="SummaryLabelList" ItemTemplate="{StaticResource SummaryLabelTemplate}" />
                            </Border>
                            <Border Height="16" />
                            <Grid x:Name="InflowTitleRow" Height="48" Padding="12,0,0,2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <TextBlock Text="Cash Inflow" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Bottom"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <Button Click="AddIncomeItem_Click" Padding="6" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
                                            AutomationProperties.Name="Add a budget item to Cash Inflow" ToolTipService.ToolTip="Add a budget item to Cash Inflow">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="0,6">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.IncomeLines}" ItemTemplate="{StaticResource IncomeNameTemplate}" />
                            </Border>
                            <Border Height="16" />
                            <Grid x:Name="OutflowTitleRow" Height="48" Padding="12,0,0,2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <TextBlock Text="Cash Outflow" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Bottom"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <Button Click="AddExpenseGroup_Click" Padding="6" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
                                            AutomationProperties.Name="Add a budget group to Cash Outflow" ToolTipService.ToolTip="Add a budget group to Cash Outflow">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="0,6">
                                <ItemsControl x:Name="OutflowNames" ItemsSource="{x:Bind ViewModel.OutflowLines}" ItemTemplate="{StaticResource OutflowNameTemplate}" />
                            </Border>
                        </StackPanel>

                        <!-- One column per month -->
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Columns}" ItemTemplate="{StaticResource MonthTemplate}" HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
