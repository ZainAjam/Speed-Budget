<Page x:Class="SpeedBudget.App.Views.BudgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    xmlns:vm="using:SpeedBudget.App.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="IncomeRowTemplate" x:DataType="vm:IncomeRow">
            <Grid ColumnSpacing="12" Padding="0,4" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <NumberBox app:Money.Format="True" Grid.Column="1" Value="{x:Bind Expected, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" PlaceholderText="0.00"
                           AutomationProperties.Name="Expected" ToolTipService.ToolTip="Expected" />
                <TextBlock Grid.Column="2" Text="{x:Bind ReceivedText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <NumberBox app:Money.Format="True" Grid.Column="3" Value="{x:Bind Held, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" PlaceholderText="0.00"
                           AutomationProperties.Name="Held for next month" ToolTipService.ToolTip="Held for next month" />
                <Button Grid.Column="4" Content="Hold all" Click="HoldAll_Click" Tag="{x:Bind}" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Column="5" Text="{x:Bind AvailableThisMonthText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExpenseRowTemplate" x:DataType="vm:ExpenseRow">
            <Grid ColumnSpacing="12" Padding="0,4" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" Margin="{x:Bind Indent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <NumberBox app:Money.Format="True" Grid.Column="1" Value="{x:Bind Budgeted, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" PlaceholderText="0.00" AutomationProperties.Name="Budgeted" />
                <TextBlock Grid.Column="2" Text="{x:Bind SpentText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind RemainingText, Mode=OneWay}" Foreground="{x:Bind RemainingBrush, Mode=OneWay}"
                           HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="4" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" ShowError="{x:Bind IsOverspent, Mode=OneWay}"
                             VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExpenseSectionTemplate" x:DataType="vm:ExpenseSection">
            <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="12" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind BudgetedText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2" Text="{x:Bind SpentText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Opacity="0.8" />
                        <TextBlock Grid.Column="3" Text="{x:Bind RemainingText, Mode=OneWay}" HorizontalTextAlignment="Right" VerticalAlignment="Center" Opacity="0.8" />
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ExpenseRowTemplate}" />
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="IncomeSectionTemplate" x:DataType="vm:IncomeSection">
            <StackPanel>
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,4" />
                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource IncomeRowTemplate}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </Page.Resources>

    <Grid Margin="32,24">
        <StackPanel x:Name="Welcome" Visibility="Collapsed" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Welcome to Speed Budget" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                       Text="Let's set up your 2027 budget. First choose what you budget for, then add your bank accounts and mark each as a budget account or a tracked account." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Start with starter items" Style="{StaticResource AccentButtonStyle}" Click="Starter_Click" />
                <Button Content="Start empty" Click="Empty_Click" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="The starter list is a typical household set of groups and items. You can rename, move or delete any of it later." />
        </StackPanel>

        <ScrollViewer x:Name="BudgetContent" Visibility="Collapsed">
            <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,16,24">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Budget" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <Button Grid.Column="1" Content="&#xE76B;" FontFamily="{StaticResource SymbolThemeFontFamily}" Click="Back_Click"
                            IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" ToolTipService.ToolTip="Previous month" AutomationProperties.Name="Previous month" />
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.MonthLabel, Mode=OneWay}" MinWidth="170" TextAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="&#xE76C;" FontFamily="{StaticResource SymbolThemeFontFamily}" Click="Forward_Click"
                            IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}" ToolTipService.ToolTip="Next month" AutomationProperties.Name="Next month" />
                    <DropDownButton Grid.Column="5" Content="Quick fill" IsEnabled="{x:Bind ViewModel.HasPreviousMonth, Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Copy last month's budget (items not yet set)" Click="CopyLast_Click" />
                                <MenuFlyoutItem Text="Budget what was spent last month" Click="SpentLast_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>

                <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Severity="Warning" Message="{x:Bind ViewModel.Message, Mode=OneWay}" IsClosable="False" />

                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="20" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Income this month" />
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.IncomeText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource StatLabel}" Text="Held for next month" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Bind ViewModel.HeldOutText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource StatLabel}" Text="Released from last month" />
                            <TextBlock Grid.Column="2" Grid.Row="1" Text="{x:Bind ViewModel.HeldInText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource StatLabel}" Text="Overflow from last month" />
                            <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.OverflowText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource StatLabel}" Text="Carried over" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.CarriedText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Style="{StaticResource StatLabel}" Text="Budgeted" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{x:Bind ViewModel.BudgetedText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                        <StackPanel Grid.Column="1" MinWidth="200" HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Available to budget" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.AvailableText, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}"
                                       Foreground="{x:Bind ViewModel.AvailableBrush, Mode=OneWay}" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.AvailableStatus, Mode=OneWay}" Foreground="{x:Bind ViewModel.AvailableBrush, Mode=OneWay}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="EmptyHint" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.8"
                           Text="There are no budget items yet. Add some under Manage items." />

                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="12" Opacity="0.7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Income" Style="{StaticResource SubtitleTextBlockStyle}" Opacity="1" />
                            <TextBlock Grid.Column="1" Text="Expected" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="2" Text="Received" HorizontalTextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="3" Text="Held for next month" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="5" Text="Available now" HorizontalTextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.IncomeSections}" ItemTemplate="{StaticResource IncomeSectionTemplate}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12" Opacity="0.7" Padding="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Spending" Style="{StaticResource SubtitleTextBlockStyle}" Opacity="1" />
                        <TextBlock Grid.Column="1" Text="Budgeted" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="2" Text="Spent" HorizontalTextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="3" Text="Left" HorizontalTextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ExpenseSections}" ItemTemplate="{StaticResource ExpenseSectionTemplate}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
