<Window x:Class="SpeedBudget.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SpeedBudget.App"
    Title="Speed Budget">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <!-- The menu is built in code, because the transaction pages under Activity follow the list of accounts. -->
    <!-- Everything sits in a host that is scaled by the zoom level; its size is the window's size divided by the zoom, so the layout fills the window at any zoom. -->
    <Grid x:Name="ZoomOuter" SizeChanged="ZoomOuter_SizeChanged">
    <Grid x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ZoomScale" />
        </Grid.RenderTransform>
    <NavigationView x:Name="Nav" KeyboardAcceleratorPlacementMode="Hidden" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="False" SelectionChanged="Nav_SelectionChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Informational" IsClosable="True">
                <InfoBar.Content>
                    <HyperlinkButton x:Name="WhatsChangedLink" Content="What's changed" Click="WhatsChanged_Click" Padding="0" />
                </InfoBar.Content>
                <InfoBar.ActionButton>
                    <Button x:Name="UpdateButton" Content="Update and restart" Click="UpdateNow_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Border x:Name="WatcherHost" Grid.Row="1" Padding="32,12,32,0" Visibility="Collapsed" AutomationProperties.Name="Pinned items">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ItemsControl x:Name="ChipList" ItemsSource="{x:Bind Watcher.Chips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="app:WatcherChip">
                                    <!-- Pressing a chip opens that item on the Budget screen; right-click removes it from the strip. -->
                                    <Button Click="Chip_Click" ContextRequested="Chip_ContextRequested" Tag="{x:Bind ItemId}" Padding="12,6" CornerRadius="14"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            ToolTipService.ToolTip="Show this item in the budget. Right-click to remove it from this strip.">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Opacity="0.8" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind RemainingText}" Foreground="{x:Bind Brush}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Offered until the strip holds three items. -->
                        <Button x:Name="AddChipButton" Click="AddChip_Click" Padding="12,6" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                AutomationProperties.Name="Add an item to the watcher strip" ToolTipService.ToolTip="Choose a budget item to keep an eye on">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock x:Name="AddChipLabel" Text="Watch a budget item" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Frame Grid.Row="2" x:Name="ContentFrame" />
            <!-- A short note at the bottom saying what Ctrl+Z (or Ctrl+Y) just did -->
            <Border x:Name="UndoToast" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,40" Padding="18,10" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <TextBlock x:Name="UndoToastText" />
            </Border>
        </Grid>
    </NavigationView>
    </Grid>
    <!-- The zoom block in the bottom right corner (like Word): smaller, the level (click to type one), larger. It is not scaled with the rest. -->
    <Border x:Name="ZoomBar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,10" Padding="4,2" CornerRadius="6" BorderThickness="1"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            AutomationProperties.Name="Zoom">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="ZoomOut" Padding="6,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out (Ctrl and -)">
                <FontIcon Glyph="&#xE738;" FontSize="12" />
            </Button>
            <Grid x:Name="ZoomLevelHost" MinWidth="52" Background="Transparent" ToolTipService.ToolTip="Click to type a zoom percentage">
                <TextBlock x:Name="ZoomLevel" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                <TextBox x:Name="ZoomLevelBox" Visibility="Collapsed" MaxLength="3" TextAlignment="Center" MinHeight="28" Padding="4,3" VerticalAlignment="Center" />
            </Grid>
            <Button x:Name="ZoomIn" Padding="6,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in (Ctrl and +)">
                <FontIcon Glyph="&#xE710;" FontSize="12" />
            </Button>
        </StackPanel>
    </Border>
    </Grid>
</Window>
